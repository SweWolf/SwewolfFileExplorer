<Application x:Class="SwewolfFileExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- The line between groups in every menu (menu bar drop-downs and right-click menus): the Fluent theme's own line is very faint,
             most of all in the dark styles. Only the Separator's look is replaced, not the menu's. The color is ours (ThemeService). -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="10,5" SnapsToDevicePixels="True"
                                Background="{DynamicResource MenuSeparatorBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
