<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyFileExplorer</AssemblyName>
    <RootNamespace>MyFileExplorer</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationIcon>Resourses\fluent_file_explorer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resourses\fluent_file_explorer.ico" />
  </ItemGroup>

</Project>
