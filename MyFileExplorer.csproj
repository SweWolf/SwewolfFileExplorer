<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyFileExplorer</AssemblyName>
    <RootNamespace>MyFileExplorer</RootNamespace>
    <Platforms>x64</Platforms>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Resourses\fluent_file_explorer.ico</ApplicationIcon>
    <!-- WPF0001: Application.ThemeMode (the Fluent light/dark theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resourses\fluent_file_explorer.ico" />
  </ItemGroup>

</Project>
