<Window x:Class="MyFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyFileExplorer.ViewModels"
        xmlns:conv="clr-namespace:MyFileExplorer.Converters"
        Title="My File Explorer"
        Icon="Resourses/fluent_file_explorer.ico"
        Height="640" Width="1024"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
    </Window.Resources>

    <!-- Window-level keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="F5"    Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewFolderCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ReopenTabCommand}"/>
        <KeyBinding Key="Left"  Modifiers="Alt" Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="F8"    Command="{Binding ToggleTreeCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- ── Tab strip ───────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ListBox x:Name="TabStrip"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseDown="TabStrip_PreviewMouseDown"
                         PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TabStrip_PreviewMouseMove"
                         DragOver="TabStrip_DragOver">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder" Margin="2,4,0,0" Padding="10,5,6,5"
                                                CornerRadius="6,6,0,0" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#E6E6E6"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding CurrentPath}">
                                <TextBlock Text="{Binding Title}" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="&#x2715;" Margin="8,0,0,0" Padding="4,1" FontSize="10"
                                        Background="Transparent" BorderThickness="0" Focusable="False"
                                        ToolTip="Close Tab (Ctrl+W)"
                                        Command="{Binding DataContext.CloseTabCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+" Command="{Binding NewTabCommand}" ToolTip="New Tab (Ctrl+T)"
                        Margin="4,4,0,0" Padding="8,2" FontSize="14"
                        Background="Transparent" BorderThickness="0" Focusable="False"/>
            </StackPanel>
        </Border>

        <!-- ── Toolbar ─────────────────────────────────────────────── -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">

                <Button Command="{Binding BackCommand}"
                        ToolTip="Back (Alt+Left)"
                        Padding="6,4">
                    <TextBlock Text="&#x276E;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Button Command="{Binding ForwardCommand}"
                        ToolTip="Forward (Alt+Right)"
                        Padding="6,4">
                    <TextBlock Text="&#x276F;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Button Command="{Binding UpCommand}"
                        ToolTip="Up one level (Backspace)"
                        Padding="6,4">
                    <TextBlock Text="&#x2191;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Separator/>

                <!-- Address bar -->
                <TextBox x:Name="AddressBar"
                         Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         Width="460"
                         VerticalContentAlignment="Center"
                         Padding="4,3"
                         FontSize="13">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding NavigateCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Command="{Binding NavigateCommand}"
                        ToolTip="Go"
                        Padding="6,4">
                    <TextBlock Text="&#x2192;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Separator/>

                <Button Command="{Binding RefreshCommand}"
                        ToolTip="Refresh (F5)"
                        Padding="6,4">
                    <TextBlock Text="&#x21BB;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Separator/>

                <ToggleButton IsChecked="{Binding ShowTree}"
                              ToolTip="Show the Folder Tree (F8)"
                              Padding="6,4">
                    <TextBlock Text="Tree" FontSize="12"/>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowFolders}"
                              ToolTip="Show Folders in the List"
                              Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C2;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Folders" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>

                <Button Command="{Binding NewFolderCommand}"
                        ToolTip="New Folder (Ctrl+Shift+N)"
                        Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C1;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="New Folder" FontSize="12"/>
                    </StackPanel>
                </Button>

            </ToolBar>
        </ToolBarTray>

        <!-- ── Status bar ──────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Main content: tree | splitter | list ────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="220" MinWidth="80"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation tree: header (up, sort order, hide) above the tree -->
            <DockPanel x:Name="TreePane" Grid.Column="0">

                <Border DockPanel.Dock="Top" Background="#F3F3F3"
                        BorderBrush="#DDDDDD" BorderThickness="0,0,1,1" Padding="4,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding UpCommand}"
                                ToolTip="Up one level (Backspace)"
                                Padding="6,2" Margin="0,1,6,0" VerticalAlignment="Top">
                            <TextBlock Text="&#x2191;" FontSize="13" FontFamily="Segoe UI"/>
                        </Button>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sort By" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox Width="100" Margin="0,1,4,1" FontSize="12"
                                      ToolTip="Sort the subfolders of the current folder by"
                                      SelectedIndex="{Binding TreeSortIndex}">
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Date Created"/>
                                <ComboBoxItem Content="Date Modified"/>
                            </ComboBox>
                            <ComboBox Width="62" Margin="0,1,0,1" FontSize="12"
                                      ToolTip="Sort direction of the subfolders"
                                      SelectedIndex="{Binding TreeSortDirectionIndex}">
                                <ComboBoxItem Content="Asc"/>
                                <ComboBoxItem Content="Desc"/>
                            </ComboBox>
                        </WrapPanel>

                        <Button Grid.Column="2" Command="{Binding ToggleTreeCommand}"
                                ToolTip="Hide the Folder Tree (F8)"
                                Padding="6,2" Margin="6,1,0,0" VerticalAlignment="Top">
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <TreeView x:Name="NavigationTree"
                          ItemsSource="{Binding TreeItems}"
                          BorderThickness="0,0,1,0"
                          BorderBrush="#DDDDDD"
                          FontSize="{Binding TreeFontSize}"
                          PreviewMouseWheel="Tree_PreviewMouseWheel"
                          SelectedItemChanged="NavigationTree_SelectedItemChanged">

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding"    Value="2,2"/>
                            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#EEEEEE"/>

            <!-- File list -->
            <ListView Grid.Column="2"
                      x:Name="FileListView"
                      ItemsSource="{Binding CurrentItems}"
                      SelectionMode="Extended"
                      FontSize="{Binding ListFontSize}"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      BorderThickness="0"
                      SelectionChanged="FileListView_SelectionChanged"
                      GridViewColumnHeader.Click="FileListView_HeaderClick"
                      ContextMenuOpening="FileListView_ContextMenuOpening"
                      PreviewMouseDown="FileListView_PreviewMouseDown"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      KeyDown="FileListView_KeyDown">

                <ListView.InputBindings>
                    <KeyBinding Key="Delete"  Command="{Binding DeleteCommand}"/>
                    <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding PermanentDeleteCommand}"/>
                    <KeyBinding Key="Back"    Command="{Binding UpCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}"/>
                    <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}"/>
                    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
                </ListView.InputBindings>

                <ListView.View>
                    <GridView>

                        <!-- Name column: icon + text -->
                        <GridViewColumn Header="Name" Width="300" x:Name="NameColumn">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Date Modified" Width="150" x:Name="DateColumn"
                                        DisplayMemberBinding="{Binding DateModified,
                                            StringFormat='MM/dd/yyyy  HH:mm'}"/>

                        <GridViewColumn Header="Date Created" Width="150" x:Name="CreatedColumn"
                                        DisplayMemberBinding="{Binding DateCreated,
                                            StringFormat='MM/dd/yyyy  HH:mm'}"/>

                        <GridViewColumn Header="Type" Width="130" x:Name="TypeColumn"
                                        DisplayMemberBinding="{Binding TypeName}"/>

                        <GridViewColumn Header="Size" Width="90" x:Name="SizeColumn"
                                        DisplayMemberBinding="{Binding Size,
                                            Converter={StaticResource FileSizeConverter}}"/>
                    </GridView>
                </ListView.View>

                <!-- Context menu — DataContext routed via Tag -->
                <ListView.ContextMenu>
                    <ContextMenu x:Name="FileContextMenu" Opened="ContextMenu_Opened">
                        <MenuItem Header="Open"       Click="CtxOpen_Click"/>
                        <MenuItem Header="Open in New Tab" Click="CtxOpenInNewTab_Click"/>
                        <MenuItem Header="Send to"    x:Name="SendToMenu"/>
                        <Separator/>
                        <MenuItem Header="Cut"        Click="CtxCut_Click"       InputGestureText="Ctrl+X"/>
                        <MenuItem Header="Copy"       Click="CtxCopy_Click"      InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Paste"      Click="CtxPaste_Click"     InputGestureText="Ctrl+V"/>
                        <Separator/>
                        <MenuItem Header="Delete"     Click="CtxDelete_Click"    InputGestureText="Del"/>
                        <MenuItem Header="Rename"     Click="CtxRename_Click"    InputGestureText="F2"/>
                        <Separator/>
                        <MenuItem Header="New Folder" Click="CtxNewFolder_Click" InputGestureText="Ctrl+Shift+N"/>
                        <Separator/>
                        <MenuItem Header="Properties" Click="CtxProperties_Click" InputGestureText="Alt+Enter"/>
                    </ContextMenu>
                </ListView.ContextMenu>

            </ListView>
        </Grid>

    </DockPanel>
</Window>
