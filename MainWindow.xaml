<Window x:Class="SwewolfFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SwewolfFileExplorer.ViewModels"
        xmlns:conv="clr-namespace:SwewolfFileExplorer.Converters"
        xmlns:helpers="clr-namespace:SwewolfFileExplorer.Helpers"
        Title="SweWolf File Explorer"
        Icon="Resourses/fluent_file_explorer.ico"
        Height="640" Width="1024"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility"/>
    </Window.Resources>

    <!-- Window-level keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="F5"    Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewFolderCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ReopenTabCommand}"/>
        <KeyBinding Key="Left"  Modifiers="Alt" Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="F8"    Command="{Binding ToggleTreeCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- ── Menu ────────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Tools">
                <MenuItem Header="_Create Shortcut..." Click="MenuCreateShortcut_Click"/>
                <MenuItem Header="_Settings" Click="MenuSettings_Click"/>
            </MenuItem>

            <!-- Workspace: folders the user saved by hand, opened again in tabs. -->
            <MenuItem Header="_Workspace">
                <MenuItem Header="_Save Current Tabs as Workspace..." Click="WorkspaceSave_Click"
                          ToolTip="Save the folders of the open tabs under a name"/>
                <MenuItem x:Name="WorkspaceOpenMenu" Header="_Open Workspace" SubmenuOpened="WorkspaceMenu_SubmenuOpened">
                    <MenuItem Header="(None)" IsEnabled="False"/>
                </MenuItem>
                <!-- Hidden for now (less clutter); the code is kept and may come back as a feature. A workspace file can
                     also be opened with the file as the program's command-line argument. -->
                <MenuItem Header="Open Workspace from _File..." Click="WorkspaceOpenFile_Click" Visibility="Collapsed"
                          ToolTip="Open a workspace file that is somewhere else, for example one you got from another computer"/>
                <MenuItem x:Name="WorkspaceDeleteMenu" Header="_Delete Workspace" SubmenuOpened="WorkspaceMenu_SubmenuOpened">
                    <MenuItem Header="(None)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show Workspaces F_older" Click="WorkspaceShowFolder_Click"
                          ToolTip="Show the folder with the workspace files"/>
            </MenuItem>

            <!-- Session: the open tabs, remembered all the time. -->
            <MenuItem Header="_Session">
                <MenuItem Header="_Start New Session..." Click="SessionStart_Click"
                          ToolTip="Start remembering the open tabs, the folders and the selected files, under a name"/>
                <MenuItem x:Name="SessionOpenMenu" Header="_Open Session" SubmenuOpened="SessionMenu_SubmenuOpened">
                    <MenuItem Header="(None)" IsEnabled="False"/>
                </MenuItem>
                <!-- Hidden for now (less clutter); the code is kept and may come back as a feature. A session file can
                     also be opened with the file as the program's command-line argument. -->
                <MenuItem Header="Open Session from _File..." Click="SessionOpenFile_Click" Visibility="Collapsed"
                          ToolTip="Open a session file that is somewhere else, for example one you got from another computer"/>
                <MenuItem x:Name="SessionStopMenuItem" Header="S_top Session" Click="SessionStop_Click"
                          ToolTip="Stop remembering the open tabs. The session file stays."/>
                <MenuItem x:Name="SessionDeleteMenu" Header="_Delete Session" SubmenuOpened="SessionMenu_SubmenuOpened">
                    <MenuItem Header="(None)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show Sessions F_older" Click="SessionShowFolder_Click"
                          ToolTip="Show the folder with the session files"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Open _Log File"   Click="MenuOpenLogFile_Click"/>
                <MenuItem Header="Open Log _Folder" Click="MenuOpenLogFolder_Click"/>
                <Separator/>
                <MenuItem Header="_About" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- ── Tab strip ───────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ListBox x:Name="TabStrip"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseDown="TabStrip_PreviewMouseDown"
                         PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TabStrip_PreviewMouseMove"
                         DragOver="TabStrip_DragOver">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- The 3 px top line is transparent, and in the accent color for the active tab (with bold text and
                                             a distinct background), so it is easy to see which tab is the active one -->
                                        <Border x:Name="TabBorder" Margin="2,4,0,0" Padding="10,2,6,5"
                                                BorderThickness="0,3,0,0" BorderBrush="Transparent"
                                                CornerRadius="6,6,0,0" Background="Transparent">
                                            <ContentPresenter x:Name="TabContent"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <Setter TargetName="TabContent" Property="TextElement.FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding CurrentPath}">
                                <TextBlock Text="{Binding Title}" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="&#x2715;" Margin="8,0,0,0" Padding="4,1" FontSize="10"
                                        Background="Transparent" BorderThickness="0" Focusable="False"
                                        ToolTip="Close Tab (Ctrl+W)"
                                        Command="{Binding DataContext.CloseTabCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+" Command="{Binding NewTabCommand}" ToolTip="New Tab (Ctrl+T)"
                        Margin="4,4,0,0" Padding="8,2" FontSize="14"
                        Background="Transparent" BorderThickness="0" Focusable="False"/>
            </StackPanel>
        </Border>

        <!-- ── Toolbar ─────────────────────────────────────────────── -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="0" BandIndex="0">

                <ToolBar.Resources>
                    <!-- The text of a toggle button that is on sits on the accent color: it needs its own contrast. -->
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToolBar.Resources>

                <Button Command="{Binding BackCommand}"
                        ToolTip="Back (Alt+Left)"
                        Padding="6,4">
                    <TextBlock Text="&#x276E;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Button Command="{Binding ForwardCommand}"
                        ToolTip="Forward (Alt+Right)"
                        Padding="6,4">
                    <TextBlock Text="&#x276F;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Button Command="{Binding UpCommand}"
                        ToolTip="Up one level (Backspace)"
                        Padding="6,4">
                    <TextBlock Text="&#x2191;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Separator/>

                <!-- Address bar. The Fluent text box draws a thicker line along its bottom edge and shows no focus in a toolbar:
                     it gets a flat template, and the frame around it does the work: 1 px line, 2 px in the accent color with focus. -->
                <Border CornerRadius="3" BorderThickness="1" Padding="1" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddressBar}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Padding" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="AddressBar"
                             Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                             Width="456"
                             VerticalContentAlignment="Center"
                             Padding="4,3"
                             BorderThickness="0"
                             FontSize="13">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding NavigateCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <Button Command="{Binding NavigateCommand}"
                        ToolTip="Go (right-click for more)"
                        Padding="6,4">
                    <Button.ContextMenu>
                        <ContextMenu Opened="GoMenu_Opened">
                            <MenuItem x:Name="GoSetRootMenuItem" Header="Set as Tree Root" Click="GoSetRoot_Click"
                                      ToolTip="Make the folder in the address bar the top of the folder tree in this tab. Not remembered."/>
                            <MenuItem x:Name="GoResetRootMenuItem" Header="Reset Tree Root" Click="GoResetRoot_Click"
                                      ToolTip="Show the whole computer in the folder tree again"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock Text="&#x2192;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Separator/>

                <Button Command="{Binding RefreshCommand}"
                        ToolTip="Refresh (F5)"
                        Padding="6,4">
                    <TextBlock Text="&#x21BB;" FontSize="13" FontFamily="Segoe UI"/>
                </Button>

                <Separator/>

                <ToggleButton IsChecked="{Binding ShowTree}"
                              ToolTip="Show the Folder Tree (F8)"
                              Padding="6,4">
                    <TextBlock Text="Tree" FontSize="12"/>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowFolders}"
                              ToolTip="Show Folders in the List"
                              Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C2;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Folders" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>

                <Button Command="{Binding NewFolderCommand}"
                        ToolTip="New Folder (Ctrl+Shift+N)"
                        Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C1;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="New Folder" FontSize="12"/>
                    </StackPanel>
                </Button>

            </ToolBar>
        </ToolBarTray>

        <!-- ── Main content: tree | splitter | list ────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="308" MinWidth="80"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="90"/>                       <!-- the file list -->
                <RowDefinition Height="Auto"/>                                   <!-- the divider -->
                <RowDefinition x:Name="InfoRow" Height="141" MinHeight="141"/>   <!-- the info panel: dragged taller with the divider -->
                <RowDefinition Height="Auto"/>                                   <!-- the status bar -->
            </Grid.RowDefinitions>

            <!-- Navigation tree: header (up, sort order, hide) above the tree -->
            <DockPanel x:Name="TreePane" Grid.Column="0" Grid.RowSpan="4">

                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,1" Padding="4,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding UpCommand}"
                                ToolTip="Up one level (Backspace)"
                                Padding="6,2" Margin="0,1,6,0" VerticalAlignment="Top">
                            <TextBlock Text="&#x2191;" FontSize="13" FontFamily="Segoe UI"/>
                        </Button>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sort By" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox Width="100" Margin="0,1,4,1" FontSize="12"
                                      ToolTip="Sort the subfolders of the current folder by"
                                      SelectedIndex="{Binding TreeSortIndex}">
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Date Created"/>
                                <ComboBoxItem Content="Date Modified"/>
                            </ComboBox>
                            <ComboBox Width="74" Margin="0,1,0,1" FontSize="12"
                                      ToolTip="Sort direction of the subfolders"
                                      SelectedIndex="{Binding TreeSortDirectionIndex}">
                                <ComboBoxItem Content="Asc"/>
                                <ComboBoxItem Content="Desc"/>
                            </ComboBox>
                        </WrapPanel>

                        <!-- Flat, and red under the mouse: a close button, as in Windows. -->
                        <Button Grid.Column="2" Command="{Binding ToggleTreeCommand}"
                                ToolTip="Hide the Folder Tree (F8)"
                                Padding="8,3" Margin="6,1,0,0" VerticalAlignment="Top" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Under the tree, at the very bottom: the picture of the current folder (a cover), when it has one.
                     Declared first, so it docks below the hidden-folders line. The area is always there (empty
                     when the folder has no picture), so the tree does not jump. A click opens it in the viewer. -->
                <Border DockPanel.Dock="Bottom" Padding="6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="233"/>
                            <Style.Triggers>
                                <!-- No rating row and no tags row: their space goes to the picture. With both rows it gives way to the tags row. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasFolderMarks}" Value="False"/>
                                        <Condition Binding="{Binding HasFolderTags}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Height" Value="265"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasFolderMarks}" Value="True"/>
                                        <Condition Binding="{Binding HasFolderTags}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Height" Value="201"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="{Binding FolderPicture}" Stretch="Uniform" MaxHeight="260"
                           HorizontalAlignment="Center" Cursor="Hand"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           MouseLeftButtonDown="FolderPicture_MouseLeftButtonDown"/>
                </Border>

                <!-- Under the tree: the tags of the current folder, read from its desktop.ini (read only), only when it has some -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding HasFolderTags, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="12" Text="{Binding FolderTagsText}" TextWrapping="Wrap"
                               ToolTip="The tags of this folder, from its desktop.ini (the Windows Tags property). They can only be read here."/>
                </Border>

                <!-- Under the tree: the rating and expectation of the current folder, only when it has one (a click edits them, as in TeraTool; Ctrl+R / Ctrl+E set them) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding HasFolderMarks, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Text="{Binding FolderRatingText}" Cursor="Hand"
                                   ToolTip="Your rating of this folder, 1 to 10 (click to change it, Ctrl+R)"
                                   MouseLeftButtonUp="FolderRating_Click"/>
                        <TextBlock FontSize="12" Text="{Binding FolderExpectationText}" Cursor="Hand" Margin="18,0,0,0"
                                   ToolTip="How good you expect this folder to be, 1 to 10 (click to change it, Ctrl+E)"
                                   MouseLeftButtonUp="FolderExpectation_Click"/>
                    </StackPanel>
                </Border>

                <!-- Under the tree: has the current folder been read? (as in TeraTool) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding FolderStatusText, Converter={StaticResource TextToVisibility}}">
                    <TextBlock FontSize="12" Text="{Binding FolderStatusText}"
                               ToolTip="Read means every file in this folder and in all folders below it has been opened. Right-click a folder to mark it."/>
                </Border>

                <!-- Under the tree: the hidden subfolders of the current folder (docked before the tree, which fills the rest) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding HasTreeHiddenFolders, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="12"
                               ToolTip="Show or hide the hidden and system subfolders of the current folder in the tree">
                        <Hyperlink Command="{Binding ToggleTreeHiddenCommand}">
                            <Run Text="{Binding TreeHiddenText, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <TreeView x:Name="NavigationTree"
                          ItemsSource="{Binding TreeItems}"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{DynamicResource LineBrush}"
                          FontSize="{Binding TreeFontSize}"
                          PreviewMouseWheel="Tree_PreviewMouseWheel"
                          ContextMenuOpening="NavigationTree_ContextMenuOpening"
                          AllowDrop="True" DragOver="NavigationTree_DragOver" Drop="NavigationTree_Drop"
                          KeyDown="NavigationTree_KeyDown"
                          SelectedItemChanged="NavigationTree_SelectedItemChanged">

                    <!-- Right-click on a folder of the tree: the menu works on that folder, which need not be the current one -->
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="TreeContextMenu" Opened="TreeContextMenu_Opened">
                            <MenuItem Header="Open"            Click="TreeCtxOpen_Click"/>
                            <MenuItem Header="Open in New Tab" Click="TreeCtxOpenInNewTab_Click"/>
                            <MenuItem Header="Set as Tree Root" Click="TreeCtxSetRoot_Click"
                                      ToolTip="Make this folder the top of the folder tree in this tab. Not remembered."/>
                            <MenuItem Header="Reset Tree Root" Click="TreeCtxResetRoot_Click"
                                      ToolTip="Show the whole computer in the folder tree again"/>
                            <MenuItem Header="Send to" x:Name="TreeSendToMenu" PreviewMouseRightButtonUp="TreeSendToMenu_RightClick"
                                      ToolTip="Right-click to edit this menu"/>
                            <Separator/>
                            <MenuItem Header="Cut"             Click="TreeCtxCut_Click"/>
                            <MenuItem Header="Copy"            Click="TreeCtxCopy_Click"/>
                            <MenuItem Header="Paste"           Click="TreeCtxPaste_Click"
                                      ToolTip="Paste into this folder"/>
                            <MenuItem Header="Copy as Path"    Click="TreeCtxCopyPath_Click"
                                      ToolTip="Copy the full path of this folder as text, in quotes"/>
                            <Separator/>
                            <MenuItem Header="Delete"          Click="TreeCtxDelete_Click"/>
                            <MenuItem Header="Rename"          Click="TreeCtxRename_Click"/>
                            <MenuItem Header="New Folder"      Click="TreeCtxNewFolder_Click"
                                      ToolTip="Make a new folder inside this folder"/>
                            <Separator/>
                            <MenuItem Header="Mark as Read"    Click="TreeCtxMarkRead_Click"
                                      ToolTip="Remember that every file in this folder and in all folders below it has been opened"/>
                            <MenuItem Header="Mark as Unread"  Click="TreeCtxMarkUnread_Click"
                                      ToolTip="Forget that anything in this folder and in all folders below it has been opened"/>
                            <MenuItem Header="Jump to Last Opened File" Click="TreeCtxJumpLast_Click"
                                      ToolTip="Go to this folder and select the file that was opened last in it"/>
                            <Separator/>
                            <MenuItem Header="Rating..."       Click="TreeCtxRating_Click"      InputGestureText="Ctrl+R"
                                      ToolTip="Your rating of this folder, 1 to 10. Leave it empty to remove it."/>
                            <MenuItem Header="Expectation..."  Click="TreeCtxExpectation_Click" InputGestureText="Ctrl+E"
                                      ToolTip="How good you expect this folder to be, 1 to 10 (decimals allowed). Leave it empty to remove it."/>
                            <!-- Open a terminal in this folder: which of the three are shown is set in Settings; one that is not
                                 installed is never shown. The icons are set in code. -->
                            <Separator x:Name="TreeTerminalSeparator"/>
                            <MenuItem x:Name="TreeTerminalItem"   Header="Open in Terminal"       Tag="WindowsTerminal" Click="TreeCtxTerminal_Click" PreviewMouseRightButtonUp="TreeCtxTerminal_RightClick"
                                      ToolTip="Right-click to open it as the administrator"/>
                            <MenuItem x:Name="TreePowerShellItem" Header="Open in PowerShell"      Tag="PowerShell"      Click="TreeCtxTerminal_Click" PreviewMouseRightButtonUp="TreeCtxTerminal_RightClick"
                                      ToolTip="Right-click to open it as the administrator"/>
                            <MenuItem x:Name="TreeCommandItem"    Header="Open in Command Prompt"  Tag="CommandPrompt"   Click="TreeCtxTerminal_Click" PreviewMouseRightButtonUp="TreeCtxTerminal_RightClick"
                                      ToolTip="Right-click to open it as the administrator"/>
                            <Separator/>
                            <MenuItem Header="Refresh"         Click="TreeCtxRefresh_Click"/>
                            <MenuItem Header="Properties"      Click="TreeCtxProperties_Click"/>
                            <Separator/>
                            <MenuItem Header="More Options"    Click="TreeCtxMoreOptions_Click"
                                      ToolTip="The full Windows menu of this folder, with the add-ons. Shift + right-click opens it at once."/>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <!-- Hidden folders (when shown) look faded, as in the list -->
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter Property="Opacity" Value="0.55"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       VerticalAlignment="Center" Margin="0,0,5,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding"    Value="2,2"/>
                            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Grid.RowSpan="4"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}"/>

            <!-- File list -->
            <ListView Grid.Column="2" Grid.Row="0"
                      x:Name="FileListView"
                      ItemsSource="{Binding CurrentItems}"
                      SelectionMode="Extended"
                      FontSize="{Binding ListFontSize}"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      BorderThickness="0"
                      SelectionChanged="FileListView_SelectionChanged"
                      GridViewColumnHeader.Click="FileListView_HeaderClick"
                      ContextMenuOpening="FileListView_ContextMenuOpening"
                      PreviewMouseDown="FileListView_PreviewMouseDown"
                      AllowDrop="True" DragOver="FileListView_DragOver" Drop="FileListView_Drop"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      KeyDown="FileListView_KeyDown"
                      PreviewTextInput="FileListView_PreviewTextInput">

                <!-- The Fluent theme makes the rows 40 px high: closer together, so more files fit on the screen -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                        <Setter Property="MinHeight" Value="26"/>
                        <Setter Property="Padding"   Value="4,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>   <!-- a cell fills its column: the Size column is right-aligned -->
                        <Style.Triggers>
                            <!-- A file that was never opened in the app: bold and/or italic, as chosen in Settings -->
                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                <Setter Property="FontWeight" Value="{Binding Weight, Source={x:Static helpers:UnreadStyle.Instance}}"/>
                                <Setter Property="FontStyle"  Value="{Binding Style,  Source={x:Static helpers:UnreadStyle.Instance}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Key="Delete"  Command="{Binding DeleteCommand}"/>
                    <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding PermanentDeleteCommand}"/>
                    <KeyBinding Key="Back"    Command="{Binding UpCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}"/>
                    <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}"/>
                    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyPathCommand}"/>
                </ListView.InputBindings>

                <ListView.View>
                    <GridView>

                        <!-- Name column: icon + text -->
                        <GridViewColumn Header="Name" Width="300" x:Name="NameColumn">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- Hidden items (when shown) look faded, as in Explorer -->
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Image Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Date Modified" Width="150" x:Name="DateColumn"
                                        DisplayMemberBinding="{Binding DateModified,
                                            StringFormat='MM/dd/yyyy  HH:mm'}"/>

                        <GridViewColumn Header="Date Created" Width="150" x:Name="CreatedColumn"
                                        DisplayMemberBinding="{Binding DateCreated,
                                            StringFormat='MM/dd/yyyy  HH:mm'}"/>

                        <GridViewColumn Header="Type" Width="130" x:Name="TypeColumn"
                                        DisplayMemberBinding="{Binding TypeName}"/>

                        <!-- Sizes are right-aligned, so the digits line up (as in Explorer), and so is the header. The header is aligned by its
                             template, not by a style for GridViewColumnHeader (a style replaces the theme's own one: the header turned white). -->
                        <GridViewColumn Header="Size" Width="90" x:Name="SizeColumn">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                               TextAlignment="Right" Margin="0,0,11,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- The tags of music files, as in TeraTool. Hidden until chosen (More... in the header menu). -->
                        <GridViewColumn Header="Artist" Width="160" x:Name="ArtistColumn"
                                        DisplayMemberBinding="{Binding Artist}"/>

                        <GridViewColumn Header="Title" Width="220" x:Name="TitleColumn"
                                        DisplayMemberBinding="{Binding Title}"/>

                        <GridViewColumn Header="Track Number" Width="110" x:Name="TrackColumn"
                                        DisplayMemberBinding="{Binding TrackText}"/>

                        <!-- The user's own rating and expectation (1-10, Ctrl+R and Ctrl+E), as in TeraTool. Hidden until used. -->
                        <GridViewColumn Header="Rating" Width="80" x:Name="RatingColumn"
                                        DisplayMemberBinding="{Binding RatingText}"/>

                        <GridViewColumn Header="Expectation" Width="100" x:Name="ExpectationColumn"
                                        DisplayMemberBinding="{Binding ExpectationText}"/>
                    </GridView>
                </ListView.View>

                <!-- Context menu — DataContext routed via Tag -->
                <ListView.ContextMenu>
                    <ContextMenu x:Name="FileContextMenu" Opened="ContextMenu_Opened">
                        <MenuItem Header="Open"       Click="CtxOpen_Click"/>
                        <MenuItem Header="Open With..." Click="CtxOpenWith_Click"/>
                        <MenuItem Header="Open in New Tab" Click="CtxOpenInNewTab_Click"/>
                        <MenuItem Header="Send to"    x:Name="SendToMenu" PreviewMouseRightButtonUp="SendToMenu_RightClick"
                                  ToolTip="Right-click to edit this menu"/>
                        <Separator/>
                        <MenuItem Header="Cut"        Click="CtxCut_Click"       InputGestureText="Ctrl+X"/>
                        <MenuItem Header="Copy"       Click="CtxCopy_Click"      InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Paste"      Click="CtxPaste_Click"     InputGestureText="Ctrl+V"/>
                        <MenuItem Header="Copy as Path" Click="CtxCopyPath_Click" InputGestureText="Ctrl+Shift+C"
                                  ToolTip="Copy the full path of the selected items as text, each in quotes"/>
                        <Separator/>
                        <MenuItem Header="Mark as Read"   Click="CtxMarkRead_Click"
                                  ToolTip="Remember that the selected files have been opened"/>
                        <MenuItem Header="Mark as Unread" Click="CtxMarkUnread_Click"
                                  ToolTip="Forget that the selected files have been opened"/>
                        <MenuItem Header="Jump to Last Opened File" Click="CtxJumpLast_Click"
                                  ToolTip="Select the file that was opened last in this folder"/>
                        <Separator/>
                        <MenuItem Header="Rating..."      Click="CtxRating_Click"      InputGestureText="Ctrl+R"
                                  ToolTip="Your rating of the selected items, 1 to 10. Leave it empty to remove it."/>
                        <MenuItem Header="Expectation..." Click="CtxExpectation_Click" InputGestureText="Ctrl+E"
                                  ToolTip="How good you expect the selected items to be, 1 to 10 (decimals allowed). Leave it empty to remove it."/>
                        <!-- Open a terminal in the selected folder, or in this folder (see the tree's menu) -->
                        <Separator x:Name="ListTerminalSeparator"/>
                        <MenuItem x:Name="ListTerminalItem"   Header="Open in Terminal"       Tag="WindowsTerminal" Click="CtxTerminal_Click" PreviewMouseRightButtonUp="CtxTerminal_RightClick"
                                  ToolTip="Right-click to open it as the administrator"/>
                        <MenuItem x:Name="ListPowerShellItem" Header="Open in PowerShell"      Tag="PowerShell"      Click="CtxTerminal_Click" PreviewMouseRightButtonUp="CtxTerminal_RightClick"
                                  ToolTip="Right-click to open it as the administrator"/>
                        <MenuItem x:Name="ListCommandItem"    Header="Open in Command Prompt"  Tag="CommandPrompt"   Click="CtxTerminal_Click" PreviewMouseRightButtonUp="CtxTerminal_RightClick"
                                  ToolTip="Right-click to open it as the administrator"/>
                        <Separator/>
                        <MenuItem Header="Delete"     Click="CtxDelete_Click"    InputGestureText="Del"/>
                        <MenuItem Header="Rename"     Click="CtxRename_Click"    InputGestureText="F2"/>
                        <Separator/>
                        <MenuItem Header="New Folder" Click="CtxNewFolder_Click" InputGestureText="Ctrl+Shift+N"/>
                        <Separator/>
                        <MenuItem Header="Properties" Click="CtxProperties_Click" InputGestureText="Alt+Enter"/>
                        <Separator/>
                        <MenuItem Header="More Options" Click="CtxMoreOptions_Click"
                                  ToolTip="The full Windows menu of the selected items (or of this folder when nothing is selected), with 7-Zip and the other add-ons. Shift + right-click opens it at once."/>
                    </ContextMenu>
                </ListView.ContextMenu>

            </ListView>

            <!-- Under the list: which item is selected, the hidden items, and a preview of a picture -->
            <!-- 117 = 1 (top line) + 8 + 100 (the preview box) + 8: with 116 the bottom line of the box was cut off -->
            <!-- The divider above the info panel: drag it up to make the panel (and the preview picture) bigger. A Thumb, not a
                 GridSplitter: the list row is a star row and the panel row a fixed one, which a GridSplitter mixes up. -->
            <!-- It is not drawn (no band: the user wanted the line only, as under the tree): it is an invisible strip over the top
                 5 px of the panel, whose own 1 px top border is the line. The row between the list and the panel is empty. -->
            <Thumb x:Name="InfoDivider" Grid.Column="2" Grid.Row="2" Height="5" Cursor="SizeNS"
                   VerticalAlignment="Top" Panel.ZIndex="2"
                   DragDelta="InfoDivider_DragDelta" DragCompleted="InfoDivider_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border x:Name="InfoPanel" Grid.Column="2" Grid.Row="2" Padding="10,8"
                    Background="{DynamicResource PaneBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>   <!-- the info line: which file, how many hidden items -->
                        <RowDefinition Height="*"/>    <!-- the preview picture and the plot -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="220"/>   <!-- (nothing yet: room for information to the left of the picture) -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The plot from the video's .nfo file, to the right of the preview picture, only when there is one
                         (it takes no space otherwise). A long plot scrolls; the whole text is also in the tooltip. -->
                    <Grid x:Name="PlotArea" Grid.Row="1" Grid.Column="2" Margin="16,0,0,0" Background="Transparent" Visibility="Collapsed"
                          PreviewMouseLeftButtonDown="PlotArea_PreviewMouseLeftButtonDown">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit Plot..." Click="PlotEdit_Click"
                                          ToolTip="Change the plot of this file, which is kept in its .nfo file (a double-click does the same)"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <ScrollViewer x:Name="PlotScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="PlotText" FontSize="14" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <!-- Where there is no plot yet: a hint, so the user sees that a double-click adds one -->
                        <TextBlock x:Name="PlotHint" FontSize="14" Text="Double-click to add a plot" Visibility="Collapsed"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- A row of its own above the picture and the plot: where the selected file is in the list (or how many are
                         selected / in the folder), and the hidden-items link well to the right of it -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock x:Name="PositionText" FontSize="12"/>

                        <TextBlock FontSize="12" Margin="84,0,16,0"
                                   Visibility="{Binding HasHiddenItems, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Show or hide the hidden and system items of this folder">
                            <Hyperlink Command="{Binding ToggleHiddenCommand}">
                                <Run Text="{Binding HiddenText, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- A click opens the picture in the picture viewer (the picture of a picture file, the cover built into a
                         music file, the preview picture of a video). The transparent border is there so that the right-click
                         menu (Choose / No / Automatic preview picture) also works on an empty square. -->
                    <Border x:Name="PreviewBox" Grid.Row="1" Grid.Column="1" Width="160" Height="100" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            ContextMenuOpening="PreviewBox_ContextMenuOpening">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="PreviewChooseItem" Header="Choose Preview Picture..." Click="PreviewChoose_Click"/>
                                <MenuItem x:Name="PreviewNoneItem"   Header="No Preview Picture"        Click="PreviewNone_Click"/>
                                <MenuItem x:Name="PreviewAutoItem"   Header="Use Automatic Preview Picture" Click="PreviewAuto_Click"/>
                                <Separator x:Name="PreviewSaveSeparator"/>
                                <MenuItem x:Name="PreviewSaveItem"   Header="Save Preview Picture As..." Click="PreviewSave_Click"/>
                                <Separator x:Name="FolderPictureSeparator"/>
                                <MenuItem x:Name="FolderPictureSetItem"  Header="Set as Folder Picture" Click="FolderPictureSet_Click"
                                          ToolTip="Show this picture under the folder tree for this folder. Only its name is kept in the library; no file is made."/>
                                <MenuItem x:Name="FolderPictureAutoItem" Header="Use Automatic Folder Picture" Click="FolderPictureAuto_Click"
                                          ToolTip="Forget the chosen picture of this folder: the program looks for one itself again"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Image x:Name="ThumbnailImage" Stretch="Uniform" Cursor="Hand"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseLeftButtonDown="ThumbnailImage_MouseLeftButtonDown"/>
                            <!-- Shown instead of the picture for a video or music file that has none (or is set to none),
                                 so the user sees where to right-click -->
                            <TextBlock x:Name="PreviewEmptyText" Text="No Preview Picture" Visibility="Collapsed"
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- A second line, under the info line (File 12/17 ...), that does the same as the one above the panel: drag it to
                         change the height of the panel. The info line itself keeps its height. It lies over the bottom of the info
                         line's row, so nothing moves, and reaches to the edges of the panel (the panel has a padding). -->
                    <Thumb x:Name="InfoLineDivider" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="5" Cursor="SizeNS"
                           VerticalAlignment="Bottom" Margin="-10,0,-10,0"
                           DragDelta="InfoDivider_DragDelta" DragCompleted="InfoDivider_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <!-- Only the 1 px line (as above the panel and under the tree); the rest of the 5 px is the grip -->
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>

            <!-- Status bar: under the list and the info panel, as what it says is about the list -->
            <!-- Only there while it has a message (an error, "Marking as read..."): the number of items is in the info panel -->
            <StatusBar Grid.Column="2" Grid.Row="3" MinHeight="24"
                       Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}">
                <StatusBarItem>
                    <!-- The status bar has no theme of its own: without this the text is black on the dark styles. -->
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

    </DockPanel>
</Window>
