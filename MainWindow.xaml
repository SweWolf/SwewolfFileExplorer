<Window x:Class="SwewolfFileExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SwewolfFileExplorer.ViewModels"
        xmlns:conv="clr-namespace:SwewolfFileExplorer.Converters"
        xmlns:helpers="clr-namespace:SwewolfFileExplorer.Helpers"
        Title="SweWolf File Explorer"
        Icon="Resourses/fluent_file_explorer.ico"
        Height="640" Width="1024"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter"/>
        <conv:DateTimeConverter x:Key="DateTimeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:TextToVisibilityConverter x:Key="TextToVisibility"/>
        <conv:ShapeIsConverter x:Key="ShapeIs"/>
    </Window.Resources>

    <!-- Window-level keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="F5"    Command="{Binding UserRefreshCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewFolderCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ReopenTabCommand}"/>
        <KeyBinding Key="Left"  Modifiers="Alt" Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="F8"    Command="{Binding ToggleTreeCommand}"/>
        <!-- Ctrl+V works wherever the focus is (the tab strip, the toolbar ...), as in the file list; a text box keeps its own paste
             (it handles the key itself, so this binding is never reached from there) -->
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteKeyCommand}"/>
        <!-- Ctrl+Z: Undo of the last file operation (a text box keeps its own undo: it handles the key itself) -->
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- ── Menu ────────────────────────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Tools">
                <MenuItem Header="_Create Shortcut..." Click="MenuCreateShortcut_Click"/>
                <MenuItem Header="_Settings" Click="MenuSettings_Click"/>
            </MenuItem>

            <!-- Workspace: folders the user saved by hand, opened again in tabs. -->
            <MenuItem x:Name="WorkspaceRootMenu" Header="_Workspace" SubmenuOpened="WorkspaceRoot_SubmenuOpened">
                <MenuItem Header="_Save Current Tabs as Workspace..." Click="WorkspaceSave_Click"
                          ToolTip="Save the folders of the open tabs under a name"/>
                <!-- Hidden for now (less clutter); the code is kept and may come back as a feature. A workspace file can
                     also be opened with the file as the program's command-line argument. -->
                <MenuItem Header="Open Workspace from _File..." Click="WorkspaceOpenFile_Click" Visibility="Collapsed"
                          ToolTip="Open a workspace file that is somewhere else, for example one you got from another computer"/>
                <!-- Only there when a workspace was opened or saved in this run; its name is in the text (set in code). -->
                <MenuItem x:Name="WorkspaceShortcutItem" Header="Create Shortcut to Workspace..." Click="WorkspaceShortcut_Click" Visibility="Collapsed"
                          ToolTip="Make a shortcut that starts this program and opens this workspace"/>
                <MenuItem Header="Workspace _Manager" Click="WorkspaceManager_Click"
                          ToolTip="Open, rename, delete or make a shortcut to a saved workspace"/>
                <!-- The saved workspaces are listed below this line, directly (one click opens one); made in code when the menu opens. -->
                <Separator/>
            </MenuItem>

            <!-- Session: the open tabs, remembered all the time. -->
            <MenuItem x:Name="SessionRootMenu" Header="_Session" SubmenuOpened="SessionRoot_SubmenuOpened">
                <MenuItem Header="_Start New Session..." Click="SessionStart_Click"
                          ToolTip="Start remembering the open tabs, the folders and the selected files, under a name"/>
                <!-- Hidden for now (less clutter); the code is kept and may come back as a feature. A session file can
                     also be opened with the file as the program's command-line argument. -->
                <MenuItem Header="Open Session from _File..." Click="SessionOpenFile_Click" Visibility="Collapsed"
                          ToolTip="Open a session file that is somewhere else, for example one you got from another computer"/>
                <MenuItem x:Name="SessionStopMenuItem" Header="S_top Session" Click="SessionStop_Click"
                          ToolTip="Stop remembering the open tabs. The session file stays."/>
                <!-- Only there while a session is on; its name is in the text (set in code). -->
                <MenuItem x:Name="SessionShortcutItem" Header="Create Shortcut to Session..." Click="SessionShortcut_Click" Visibility="Collapsed"
                          ToolTip="Make a shortcut that starts this program and goes on with this session"/>
                <MenuItem Header="Session _Manager" Click="SessionManager_Click"
                          ToolTip="Open, rename, delete or make a shortcut to a saved session"/>
                <!-- The saved sessions are listed below this line, directly (one click opens one); made in code when the menu opens. -->
                <Separator/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="SweWolf File Explorer _Help" InputGestureText="F1" Click="MenuHelp_Click"/>
                <Separator/>
                <MenuItem Header="Open _Log File"   Click="MenuOpenLogFile_Click"/>
                <MenuItem Header="Open Log _Folder" Click="MenuOpenLogFolder_Click"/>
                <Separator/>
                <MenuItem Header="_About" Click="MenuAbout_Click"/>
            </MenuItem>

            <!-- Only shown when the startup check (Settings > Updates) found a newer version; the text is set in code. -->
            <MenuItem x:Name="NewVersionMenuItem" Header="New Version Available" Click="NewVersion_Click" Visibility="Collapsed"
                      FontWeight="SemiBold" ToolTip="A newer version has been released. Click to open its page on GitHub."/>

        </Menu>

        <!-- ── Tab strip ───────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <ListBox x:Name="TabStrip"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         PreviewMouseDown="TabStrip_PreviewMouseDown"
                         PreviewMouseRightButtonUp="TabStrip_PreviewMouseRightButtonUp"
                         KeyDown="TabStrip_KeyDown"
                         PreviewMouseLeftButtonDown="TabStrip_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="TabStrip_PreviewMouseMove"
                         DragOver="TabStrip_DragOver" DragLeave="TabStrip_DragLeave" Drop="TabStrip_DragLeave">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- The 3 px top line is transparent, and in the accent color for the active tab (with bold text and
                                             a distinct background), so it is easy to see which tab is the active one -->
                                        <Border x:Name="TabBorder" Margin="2,4,0,0" Padding="10,2,6,5"
                                                BorderThickness="0,3,0,0" BorderBrush="Transparent"
                                                CornerRadius="6,6,0,0" Background="Transparent">
                                            <ContentPresenter x:Name="TabContent"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                                <Setter TargetName="TabContent" Property="TextElement.FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding CurrentPath}">
                                <TextBlock Text="{Binding Title}" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="&#x2715;" Margin="8,0,0,0" Padding="4,1" FontSize="10"
                                        Background="Transparent" BorderThickness="0" Focusable="False"
                                        ToolTip="Close Tab (Ctrl+W)"
                                        Command="{Binding DataContext.CloseTabCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="+" Command="{Binding NewTabCommand}" ToolTip="New Tab (Ctrl+T)"
                        Margin="4,4,0,0" Padding="8,2" FontSize="14"
                        Background="Transparent" BorderThickness="0" Focusable="False"/>
            </StackPanel>
        </Border>

        <!-- ── Toolbar ─────────────────────────────────────────────── -->
        <ToolBarTray x:Name="MainToolBarTray" DockPanel.Dock="Top" IsLocked="True" SizeChanged="MainToolBarTray_SizeChanged">
            <ToolBar x:Name="MainToolBar" Band="0" BandIndex="0">

                <ToolBar.Resources>
                    <!-- The text of a toggle button that is on sits on the accent color: it needs its own contrast. -->
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                         Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToolBar.Resources>

                <Button Command="{Binding BackCommand}"
                        ToolTip="{Binding BackTip}"
                        Padding="6,4">
                    <TextBlock Text="&#xE76B;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </Button>

                <Button Command="{Binding ForwardCommand}"
                        ToolTip="{Binding ForwardTip}"
                        Padding="6,4">
                    <TextBlock Text="&#xE76C;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </Button>

                <Button Command="{Binding UpCommand}"
                        ToolTip="{Binding UpTip}"
                        Padding="6,4">
                    <TextBlock Text="&#xE74A;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </Button>

                <Separator/>

                <!-- Address bar. The Fluent text box draws a thicker line along its bottom edge and shows no focus in a toolbar:
                     it gets a flat template, and the frame around it does the work: 1 px line, 2 px in the accent color with focus. -->
                <Border x:Name="AddressFrame" CornerRadius="3" BorderThickness="1" Padding="1" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AddressBar}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Padding" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="AddressBar"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="AddressBar_PreviewKeyDown"
                             Width="638"
                             VerticalContentAlignment="Center"
                             Padding="4,3"
                             BorderThickness="0"
                             FontSize="13">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                    <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding NavigateCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <Button Command="{Binding NavigateCommand}"
                        Click="AddressGo_Click"
                        ToolTip="Go (right-click for more)"
                        Padding="6,4">
                    <Button.ContextMenu>
                        <ContextMenu Opened="GoMenu_Opened">
                            <MenuItem x:Name="GoSetRootMenuItem" Header="Set as Tree Root" Click="GoSetRoot_Click"
                                      ToolTip="Make the folder in the address bar the top of the folder tree in this tab. Not remembered."/>
                            <MenuItem x:Name="GoResetRootMenuItem" Header="Reset Tree Root" Click="GoResetRoot_Click"
                                      ToolTip="Show the whole computer in the folder tree again"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock Text="&#xE72A;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </Button>

                <Separator/>

                <Button Command="{Binding UserRefreshCommand}"
                        ToolTip="{Binding RefreshTip}"
                        Padding="6,4">
                    <TextBlock Text="&#xE72C;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </Button>

                <Separator/>

                <ToggleButton IsChecked="{Binding ShowTree}"
                              ToolTip="Show the Folder Tree (F8)"
                              Padding="6,4">
                    <TextBlock Text="Tree" FontSize="12"/>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ShowFolders}"
                              ToolTip="Show Folders in the List"
                              Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C2;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Folders" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Pressed = the extensions of known file types are shown (.txt, .jpg ...): Windows' "Hide extensions for known file types", the other way round -->
                <ToggleButton IsChecked="{Binding ShowExtensions}"
                              ToolTip="Show File Name Extensions (.txt, .jpg ...) of Known File Types"
                              Padding="6,4">
                    <TextBlock Text=".ext" FontSize="12"/>
                </ToggleButton>

                <Button Command="{Binding NewFolderCommand}"
                        ToolTip="New Folder (Ctrl+Shift+N)"
                        Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4C1;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="New Folder" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Separator/>

                <!-- A bar above the list where the names can be filtered: only what contains the typed letters is listed -->
                <ToggleButton x:Name="FilterToggle" Click="FilterToggle_Click"
                              ToolTip="Filter the List by Name (Ctrl+F)"
                              Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Filter" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>

                <!-- Shows and hides the Play bar in the info panel (Ctrl+P): hidden when the program starts -->
                <ToggleButton x:Name="PlayToggle" Click="PlayToggle_Click"
                              ToolTip="Show the Play Bar: Continuous Play and Other Play Modes (Ctrl+P)"
                              Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L9.5,5.5 L0,11 Z" Width="9.5" Height="11" Stretch="Fill" SnapsToDevicePixels="True" VerticalAlignment="Center" Margin="0,0,5,0"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        <TextBlock Text="Play" FontSize="12"/>
                    </StackPanel>
                </ToggleButton>

            </ToolBar>
        </ToolBarTray>

        <!-- ── Main content: tree | splitter | list ────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="308" MinWidth="80"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="90"/>                       <!-- the file list -->
                <RowDefinition Height="Auto"/>                                   <!-- the divider -->
                <RowDefinition x:Name="InfoRow" Height="141" MinHeight="141"/>   <!-- the info panel: dragged taller with the divider -->
                <RowDefinition Height="Auto"/>                                   <!-- the status bar -->
            </Grid.RowDefinitions>

            <!-- Navigation tree: header (up, sort order, hide) above the tree -->
            <DockPanel x:Name="TreePane" Grid.Column="0" Grid.RowSpan="4">

                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,1" Padding="4,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding UpCommand}"
                                ToolTip="{Binding UpTip}"
                                Padding="6,2" Margin="0,1,6,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE74A;" FontSize="16" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sort By" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox Width="100" Margin="0,1,4,1" FontSize="12"
                                      ToolTip="Sort the subfolders of the current folder by"
                                      SelectedIndex="{Binding TreeSortIndex}">
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Date Created"/>
                                <ComboBoxItem Content="Date Modified"/>
                            </ComboBox>
                            <ComboBox Width="74" Margin="0,1,0,1" FontSize="12"
                                      ToolTip="Sort direction of the subfolders"
                                      SelectedIndex="{Binding TreeSortDirectionIndex}">
                                <ComboBoxItem Content="Asc"/>
                                <ComboBoxItem Content="Desc"/>
                            </ComboBox>
                        </WrapPanel>

                        <!-- Flat, and red under the mouse: a close button, as in Windows. -->
                        <Button Grid.Column="2" Command="{Binding ToggleTreeCommand}"
                                ToolTip="Hide the Folder Tree (F8)"
                                Padding="8,3" Margin="6,1,0,0" VerticalAlignment="Top" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Under the tree, at the very bottom: the picture of the current folder (a cover), when it has one.
                     Declared first, so it docks below the hidden-folders line. The area is always there (empty
                     when the folder has no picture), so the tree does not jump. A click opens it in the viewer. -->
                <Border DockPanel.Dock="Bottom" Padding="6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding ShowFolderPicture, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="233"/>
                            <Style.Triggers>
                                <!-- No rating row and no tags row: their space goes to the picture. With both rows it gives way to the tags row. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasFolderMarks}" Value="False"/>
                                        <Condition Binding="{Binding HasFolderTags}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Height" Value="265"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasFolderMarks}" Value="True"/>
                                        <Condition Binding="{Binding HasFolderTags}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Height" Value="201"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Background="Transparent">
                        <Grid.ContextMenu>
                            <ContextMenu Opened="FolderPictureMenu_Opened">
                                <MenuItem x:Name="FolderPicChooseItem" Header="Choose Folder Picture..." Click="FolderPictureChoose_Click"
                                          ToolTip="Pick a picture file for this folder (it is remembered in the library; no file is made or changed)"/>
                                <MenuItem x:Name="FolderPicNoneItem" Header="No Folder Picture" Click="FolderPictureNone_Click"
                                          ToolTip="Show no picture for this folder"/>
                                <MenuItem x:Name="FolderPicAutoItem" Header="Use Automatic Folder Picture" Click="FolderPictureAuto_Click"
                                          ToolTip="Forget the choice: the program looks for a picture itself again"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Image Source="{Binding FolderPicture}" Stretch="Uniform" MaxHeight="260"
                               HorizontalAlignment="Center" Cursor="Hand"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="FolderPicture_MouseLeftButtonDown"/>
                        <!-- The "x" that hides the picture (red under the mouse, as the one above the tree); the button in the status line brings it back -->
                        <Button Command="{Binding HideFolderPictureCommand}"
                                ToolTip="Hide the Folder Picture (the button in the status line shows it again)"
                                Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Under the tree: the tags of the current folder, from its desktop.ini, only when it has some (a double-click edits them;
                     Set Tags... in the tree's menu is the way to give a folder its first tags) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding HasFolderTags, Converter={StaticResource BoolToVisibility}}"
                        MouseLeftButtonDown="FolderTags_MouseLeftButtonDown">
                    <TextBlock FontSize="12" Text="{Binding FolderTagsText}" TextWrapping="Wrap"
                               ToolTip="The tags of this folder, from its desktop.ini (the Windows Tags property). Double-click to change them."/>
                </Border>

                <!-- Under the tree: the rating and expectation of the current folder, only when it has one (a click edits them, as in TeraTool; Ctrl+R / Ctrl+E set them) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding HasFolderMarks, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Text="{Binding FolderRatingText}" Cursor="Hand"
                                   ToolTip="Your rating of this folder, 1 to 10 (click to change it, Ctrl+R)"
                                   MouseLeftButtonUp="FolderRating_Click"/>
                        <TextBlock FontSize="12" Text="{Binding FolderExpectationText}" Cursor="Hand" Margin="18,0,0,0"
                                   ToolTip="How good you expect this folder to be, 1 to 10 (click to change it, Ctrl+E)"
                                   MouseLeftButtonUp="FolderExpectation_Click"/>
                    </StackPanel>
                </Border>

                <!-- Under the tree: has the current folder been read? (as in TeraTool) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding ShowFolderInfoRow, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Only while the folder picture is hidden: brings it back. A small picture (frame, hill, sun) says what it is. -->
                        <Button Command="{Binding ShowFolderPictureCommand}" Focusable="False" Padding="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                ToolTip="Show the Folder Picture">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowFolderPicture}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Canvas Width="16" Height="14">
                                <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="15" Height="13" RadiusX="2" RadiusY="2" Stroke="#5B9BD5" StrokeThickness="1"/>
                                <Path Fill="#5B9BD5" Data="M2,12.5 L6,6.5 L9,10 L11,8 L14,12.5 Z"/>
                                <Ellipse Canvas.Left="10.5" Canvas.Top="2.5" Width="3" Height="3" Fill="#F0B400"/>
                            </Canvas>
                        </Button>
                        <TextBlock FontSize="12" Text="{Binding FolderStatusLine}" VerticalAlignment="Center"
                                   ToolTip="Read means every file in this folder and in all folders below it has been opened. Right-click a folder to mark it."/>
                    </StackPanel>
                </Border>

                <!-- Under the tree: the hidden subfolders of the current folder (docked before the tree, which fills the rest) -->
                <Border DockPanel.Dock="Bottom" Padding="10,6"
                        Background="{DynamicResource PaneBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,0"
                        Visibility="{Binding HasTreeInfo, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <TextBlock FontSize="12" Text="{Binding TreeCountsText}" Margin="0,0,5,0"
                                   ToolTip="How many subfolders and archive files (zip, rar, 7z ...) the current folder has"/>
                        <TextBlock FontSize="12" Visibility="{Binding HasTreeHiddenFolders, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Click to show or hide the hidden and system subfolders of the current folder in the tree">
                            <Hyperlink Command="{Binding ToggleTreeHiddenCommand}">
                                <Run Text="{Binding TreeHiddenText, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                </Border>

                <TreeView x:Name="NavigationTree"
                          ItemsSource="{Binding TreeItems}"
                          BorderThickness="0,0,1,0"
                          BorderBrush="{DynamicResource LineBrush}"
                          FontSize="{Binding TreeFontSize}"
                          FontFamily="{Binding ContentFontFamily}"
                          PreviewMouseWheel="Tree_PreviewMouseWheel"
                          ContextMenuOpening="NavigationTree_ContextMenuOpening"
                          PreviewMouseRightButtonDown="NavigationTree_PreviewMouseRightButtonDown"
                          AllowDrop="True" DragOver="NavigationTree_DragOver" Drop="NavigationTree_Drop"
                          KeyDown="NavigationTree_KeyDown"
                          PreviewTextInput="NavigationTree_PreviewTextInput"
                          SelectedItemChanged="NavigationTree_SelectedItemChanged">

                    <!-- Right-click on a folder of the tree: the menu works on that folder, which need not be the current one -->
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="TreeContextMenu" Opened="TreeContextMenu_Opened" Closed="TreeContextMenu_Closed">
                            <MenuItem Header="Open"            Click="TreeCtxOpen_Click"/>
                            <MenuItem Header="Open in New Tab" Click="TreeCtxOpenInNewTab_Click"/>
                            <MenuItem Header="Open in Windows Explorer" Click="TreeCtxExplorer_Click"
                                      ToolTip="Open this folder in Windows' own File Explorer"/>
                            <MenuItem Header="Send to" x:Name="TreeSendToMenu" PreviewMouseRightButtonUp="TreeSendToMenu_RightClick"
                                      ToolTip="Right-click to edit this menu"/>
                            <MenuItem Header="Add to Bookmarks" Click="TreeCtxBookmark_Click" InputGestureText="Ctrl+D"
                                      ToolTip="Keep a shortcut to this folder in the Bookmarks at the top of the tree"/>
                            <MenuItem Header="Set as Tree Root" Click="TreeCtxSetRoot_Click"
                                      ToolTip="Make this folder the top of the folder tree in this tab. Not remembered."/>
                            <MenuItem Header="Reset Tree Root" Click="TreeCtxResetRoot_Click"
                                      ToolTip="Show the whole computer in the folder tree again"/>
                            <!-- Send to VirusTotal: only for a packed file or playlist node, a group of its own -->
                            <Separator x:Name="TreeVirusTotalSeparator" Visibility="Collapsed"/>
                            <MenuItem x:Name="TreeVirusTotalItem" Header="Send to VirusTotal" Click="TreeCtxVirusTotal_Click" Visibility="Collapsed"
                                      ToolTip="Look up this file on VirusTotal: its SHA-256 is worked out and VirusTotal's page for it opens in your browser. Nothing is uploaded."/>
                            <Separator/>
                            <MenuItem Header="Cut"             Click="TreeCtxCut_Click"   InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy"            Click="TreeCtxCopy_Click"  InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste"           Click="TreeCtxPaste_Click" InputGestureText="Ctrl+V"
                                      ToolTip="Paste into this folder"/>
                            <MenuItem Header="Copy as Path"    Click="TreeCtxCopyPath_Click" InputGestureText="Ctrl+Shift+C"
                                      ToolTip="Copy the full path of this folder as text, in quotes"/>
                            <MenuItem Header="Move/Copy to Folder..." Click="TreeCtxMoveCopyTo_Click" InputGestureText="Ctrl+M"
                                      ToolTip="Move or copy this folder to a folder you choose"/>
                            <MenuItem Header="Create Shortcut..." Click="TreeCtxCreateShortcut_Click"
                                      ToolTip="Make a shortcut to this folder in a folder you choose"/>
                            <MenuItem Header="Create Playlist..." Click="TreeCtxCreatePlaylist_Click"
                                      ToolTip="Make an M3U playlist in this folder, with all the files or none to start with"/>
                            <Separator/>
                            <MenuItem Header="Delete"          Click="TreeCtxDelete_Click" InputGestureText="Del"/>
                            <MenuItem Header="Rename..."       Click="TreeCtxRename_Click" InputGestureText="F2"/>
                            <Separator/>
                            <MenuItem Header="Mark as Read"    Click="TreeCtxMarkRead_Click"
                                      ToolTip="Remember that every file in this folder and in all folders below it has been opened"/>
                            <MenuItem Header="Mark as Unread"  Click="TreeCtxMarkUnread_Click"
                                      ToolTip="Forget that anything in this folder and in all folders below it has been opened"/>
                            <MenuItem Header="Jump to Last Opened File" Click="TreeCtxJumpLast_Click"
                                      ToolTip="Go to this folder and select the file that was opened last in it"/>
                            <Separator/>
                            <MenuItem Header="Rating..."       Click="TreeCtxRating_Click"      InputGestureText="Ctrl+R"
                                      ToolTip="Your rating of this folder, 1 to 10. Leave it empty to remove it."/>
                            <MenuItem Header="Expectation..."  Click="TreeCtxExpectation_Click" InputGestureText="Ctrl+E"
                                      ToolTip="How good you expect this folder to be, 1 to 10 (decimals allowed). Leave it empty to remove it."/>
                            <MenuItem Header="Set Tags..."     Click="TreeCtxTags_Click"
                                      ToolTip="The tags of this folder, kept in its desktop.ini like Windows' Tags property. Leave it empty to remove them."/>
                            <!-- Open a terminal in this folder: which of the three are shown is set in Settings; one that is not
                                 installed is never shown. The icons are set in code. -->
                            <Separator x:Name="TreeTerminalSeparator"/>
                            <MenuItem x:Name="TreeTerminalItem"   Header="Open in Terminal"       Tag="WindowsTerminal" Click="TreeCtxTerminal_Click" PreviewMouseRightButtonUp="TreeCtxTerminal_RightClick"
                                      ToolTip="Right-click to open it as the administrator"/>
                            <MenuItem x:Name="TreePowerShellItem" Header="Open in PowerShell"      Tag="PowerShell"      Click="TreeCtxTerminal_Click" PreviewMouseRightButtonUp="TreeCtxTerminal_RightClick"
                                      ToolTip="Right-click to open it as the administrator"/>
                            <MenuItem x:Name="TreeCommandItem"    Header="Open in Command Prompt"  Tag="CommandPrompt"   Click="TreeCtxTerminal_Click" PreviewMouseRightButtonUp="TreeCtxTerminal_RightClick"
                                      ToolTip="Right-click to open it as the administrator"/>
                            <Separator/>
                            <MenuItem Header="New Folder"      Click="TreeCtxNewFolder_Click" InputGestureText="Ctrl+Shift+N"
                                      ToolTip="Make a new folder inside this folder"/>
                            <MenuItem Header="New Text Document..." Click="TreeCtxNewTextDocument_Click"
                                      ToolTip="Make an empty text file (.txt) in this folder. Cancel makes no file."/>
                            <MenuItem Header="New File from Clipboard" Click="TreeCtxNewFileFromClipboard_Click"
                                      ToolTip="Make a text file (.txt) of the text on the clipboard, or a picture file (.png) of the picture on it, in this folder. Cancel throws the file away."/>
                            <Separator/>
                            <MenuItem x:Name="TreeFileInfoItem" Header="File Info Viewer" Click="TreeCtxFileInfo_Click" Visibility="Collapsed"
                                      ToolTip="Show everything about this file in File Info Viewer"/>
                            <MenuItem x:Name="TreeDriveDataItem" Click="TreeCtxDriveData_Click" Visibility="Collapsed"/>
                            <MenuItem x:Name="TreeCleanUpItem" Click="TreeCtxCleanUp_Click" Visibility="Collapsed"/>
                            <Separator x:Name="TreeCleanUpSeparator" Visibility="Collapsed"/>
                            <MenuItem Header="Properties"      Click="TreeCtxProperties_Click" InputGestureText="Alt+Enter"/>
                            <Separator/>
                            <MenuItem Header="More Options"    Click="TreeCtxMoreOptions_Click"
                                      ToolTip="The full Windows menu of this folder, with the add-ons. Shift + right-click opens it at once."/>
                        </ContextMenu>
                    </TreeView.ContextMenu>

                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <!-- The outline of the folder a right-click menu is open on (Settings > Folder Tree: only when a right-click does not select it) -->
                            <Border BorderThickness="1" CornerRadius="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsContextTarget}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <!-- Hidden folders (when shown) look faded, as in the list -->
                                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="{Binding Icon}" Width="{Binding DataContext.TreeIconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.TreeIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <!-- Bookmarks, Quick Access and This PC have a drawn icon below instead -->
                                                    <DataTrigger Binding="{Binding IconShape, Converter={StaticResource TextToVisibility}}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <!-- Drawn icons (16 x 16, fixed colors that work on light and dark): a bookmark ribbon, a star, a computer -->
                                    <Viewbox Width="{Binding DataContext.TreeIconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.TreeIconSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Visibility="{Binding IconShape, Converter={StaticResource TextToVisibility}}">
                                        <Canvas Width="16" Height="16">
                                        <Path Fill="#2F6FD6" Data="M3.5,1.5 H12.5 V14.5 L8,10.8 L3.5,14.5 Z"
                                              Visibility="{Binding IconShape, Converter={StaticResource ShapeIs}, ConverterParameter=bookmark}"/>
                                        <Path Fill="#F0B400" Data="M8,0.8 L10.1,5.7 L15.4,6.1 L11.3,9.5 L12.6,14.7 L8,11.9 L3.4,14.7 L4.7,9.5 L0.6,6.1 L5.9,5.7 Z"
                                              Visibility="{Binding IconShape, Converter={StaticResource ShapeIs}, ConverterParameter=star}"/>
                                        <Path Fill="#3E8EDE" Data="M1.5,2 H14.5 V11 H1.5 Z M5,12.2 H11 V13.6 H5 Z"
                                              Visibility="{Binding IconShape, Converter={StaticResource ShapeIs}, ConverterParameter=pc}"/>
                                    </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Padding"    Value="2,2"/>
                            <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Grid.RowSpan="4"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}"/>

            <!-- File list, with the filter bar above it when it is switched on -->
            <DockPanel Grid.Column="2" Grid.Row="0">
            <Border x:Name="FilterBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="8,5"
                    Background="{DynamicResource PaneBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <Button x:Name="FilterClearButton" DockPanel.Dock="Right" TabIndex="6" Content="&#x2715;" FontSize="11" Padding="7,2" Margin="6,0,0,0"
                            ToolTip="Clear the filter (Esc)" Click="FilterClear_Click"/>
                    <TextBlock x:Name="FilterCountText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <!-- The rating filter: right of the name box. The value box is only used by the three comparisons. -->
                    <ComboBox x:Name="RatingValueBox" DockPanel.Dock="Right" TabIndex="5" Width="84" MinWidth="84" FontSize="12" Margin="6,0,0,0" SelectedIndex="4"
                              ToolTip="The rating to compare with (1 to 10)" SelectionChanged="RatingFilter_Changed" IsEnabled="False">
                        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="9"/><ComboBoxItem Content="10"/>
                    </ComboBox>
                    <ComboBox x:Name="RatingModeBox" DockPanel.Dock="Right" TabIndex="4" Width="120" FontSize="12" Margin="6,0,0,0" SelectedIndex="0"
                              ToolTip="Show only the items with a certain rating. Items with no rating are hidden by At Least, Exactly and At Most."
                              SelectionChanged="RatingFilter_Changed">
                        <ComboBoxItem Content="Any Rating"/>
                        <ComboBoxItem Content="At Least"/>
                        <ComboBoxItem Content="Exactly"/>
                        <ComboBoxItem Content="At Most"/>
                        <ComboBoxItem Content="Unrated Only"/>
                    </ComboBox>
                    <TextBlock Text="Rating:" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="12"/>
                    <!-- The date filter: between the name box and the rating. The date picker is only shown when a comparison is chosen. -->
                    <TextBox x:Name="DateTimeBox" DockPanel.Dock="Right" TabIndex="3" Width="100" FontSize="12" Padding="3" Margin="6,0,0,0" Visibility="Collapsed"
                             VerticalContentAlignment="Center" MaxLength="12"
                             ToolTip="The time of day (hours and minutes, written as Windows shows the time). Up and Down arrows or the mouse wheel change the minutes, Page Up and Page Down the hours."
                             TextChanged="DateTime_TextChanged" LostFocus="DateTime_LostFocus"
                             PreviewKeyDown="DateTime_PreviewKeyDown" PreviewMouseWheel="DateTime_PreviewMouseWheel"
                             PreviewMouseLeftButtonDown="DateTime_PreviewMouseLeftButtonDown"/>
                    <DatePicker x:Name="DateValuePicker" DockPanel.Dock="Right" TabIndex="2" Width="130" FontSize="12" Margin="6,0,0,0" Visibility="Collapsed"
                                ToolTip="The date to compare with."
                                SelectedDateChanged="DateFilter_Changed"/>
                    <ComboBox x:Name="DateModeBox" DockPanel.Dock="Right" TabIndex="1" Width="120" FontSize="12" Margin="6,0,0,0" SelectedIndex="0"
                              ToolTip="Show only the items modified later or earlier than a date and time. An item modified at exactly that minute is included."
                              SelectionChanged="DateFilter_Changed">
                        <ComboBoxItem Content="Any Date"/>
                        <ComboBoxItem Content="Later Than"/>
                        <ComboBoxItem Content="Earlier Than"/>
                    </ComboBox>
                    <TextBlock Text="Modified:" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0" FontSize="12"/>
                    <TextBox x:Name="FilterBox" TabIndex="0" Padding="3" MinWidth="200"
                             ToolTip="Only the items whose name contains these letters are shown. Several words: every word must be in the name."
                             TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"/>
                </DockPanel>
            </Border>
            <Grid>
            <!-- The drives of This PC: a grid of its own (other columns than a folder's). Shown instead of the file list while This PC is selected. -->
            <ListView x:Name="DrivesListView"
                      Visibility="Collapsed"
                      ItemsSource="{Binding DriveRows}"
                      SelectionMode="Single"
                      FontSize="{Binding ListFontSize}"
                      FontFamily="{Binding ContentFontFamily}"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      BorderThickness="0"
                      MouseDoubleClick="DrivesListView_MouseDoubleClick"
                      KeyDown="DrivesListView_KeyDown"
                      PreviewMouseRightButtonDown="DrivesListView_PreviewMouseRightButtonDown"
                      PreviewMouseRightButtonUp="DrivesListView_PreviewMouseRightButtonUp">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                        <Setter Property="MinHeight" Value="26"/>
                        <Setter Property="Padding"   Value="4,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding TypeName}"/>
                        <GridViewColumn Header="File System" Width="110" DisplayMemberBinding="{Binding FileSystem}"/>
                        <GridViewColumn Header="Total Size" Width="110">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Right" TextAlignment="Right"/></DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding TotalText}" TextAlignment="Right" Margin="0,0,11,0"/></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Free Space" Width="110">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Right" TextAlignment="Right"/></DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding FreeText}" TextAlignment="Right" Margin="0,0,11,0"/></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tracking Data Location" Width="180" DisplayMemberBinding="{Binding TrackingText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <ListView
                      x:Name="FileListView"
                      ItemsSource="{Binding CurrentItems}"
                      SelectionMode="Extended"
                      IsTextSearchEnabled="False"
                      FontSize="{Binding ListFontSize}"
                      FontFamily="{Binding ContentFontFamily}"
                      PreviewMouseWheel="List_PreviewMouseWheel"
                      BorderThickness="0"
                      SelectionChanged="FileListView_SelectionChanged"
                      GridViewColumnHeader.Click="FileListView_HeaderClick"
                      ContextMenuOpening="FileListView_ContextMenuOpening"
                      PreviewMouseDown="FileListView_PreviewMouseDown"
                      AllowDrop="True" DragOver="FileListView_DragOver" Drop="FileListView_Drop"
                      MouseDoubleClick="FileListView_MouseDoubleClick"
                      KeyDown="FileListView_KeyDown"
                      PreviewTextInput="FileListView_PreviewTextInput">

                <!-- The Fluent theme makes the rows 40 px high: closer together, so more files fit on the screen -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                        <Setter Property="MinHeight" Value="26"/>
                        <Setter Property="Padding"   Value="4,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>   <!-- a cell fills its column: the Size column is right-aligned -->
                        <Style.Triggers>
                            <!-- A file that was never opened in the app: bold and/or italic, as chosen in Settings -->
                            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                <Setter Property="FontWeight" Value="{Binding Weight, Source={x:Static helpers:UnreadStyle.Instance}}"/>
                                <Setter Property="FontStyle"  Value="{Binding Style,  Source={x:Static helpers:UnreadStyle.Instance}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Key="Delete"  Command="{Binding DeleteCommand}"/>
                    <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding PermanentDeleteCommand}"/>
                    <KeyBinding Key="Back"    Command="{Binding UpCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}"/>
                    <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}"/>
                    <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteKeyCommand}"/>
                    <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyPathCommand}"/>
                </ListView.InputBindings>

                <ListView.View>
                    <GridView>

                        <!-- Name column: icon + text -->
                        <GridViewColumn Header="Name" Width="300" x:Name="NameColumn">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- Hidden items (when shown) look faded, as in Explorer -->
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Image Source="{Binding Icon}"
                                               Width="{Binding DataContext.ListIconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.ListIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Date Modified" Width="150" x:Name="DateColumn"
                                        DisplayMemberBinding="{Binding DateModified, Converter={StaticResource DateTimeConverter}}"/>

                        <GridViewColumn Header="Date Created" Width="150" x:Name="CreatedColumn"
                                        DisplayMemberBinding="{Binding DateCreated, Converter={StaticResource DateTimeConverter}}"/>

                        <GridViewColumn Header="Type" Width="130" x:Name="TypeColumn"
                                        DisplayMemberBinding="{Binding TypeName}"/>

                        <!-- Sizes are right-aligned, so the digits line up (as in Explorer), and so is the header. The header is aligned by its
                             template, not by a style for GridViewColumnHeader (a style replaces the theme's own one: the header turned white). -->
                        <GridViewColumn Header="Size" Width="90" x:Name="SizeColumn">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                               TextAlignment="Right" Margin="0,0,11,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- The tags of music files, as in TeraTool. Hidden until chosen (More... in the header menu). -->
                        <GridViewColumn Header="Artist" Width="160" x:Name="ArtistColumn"
                                        DisplayMemberBinding="{Binding Artist}"/>

                        <GridViewColumn Header="Title" Width="220" x:Name="TitleColumn"
                                        DisplayMemberBinding="{Binding Title}"/>

                        <!-- Track number: the header is "#" as in Explorer, and the numbers are right-aligned like Size (header and cells). -->
                        <GridViewColumn Header="#" Width="70" x:Name="TrackColumn">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TrackText}" TextAlignment="Right" Margin="0,0,11,0"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- What is known about the file itself (read in the background, like the tags): music, video and pictures.
                             Left-aligned, header too, like the other columns (only Size is right-aligned). Dimensions is width x height in one column. -->
                        <GridViewColumn Header="Length" Width="80" x:Name="LengthColumn"
                                        DisplayMemberBinding="{Binding LengthText}"/>

                        <GridViewColumn Header="Bitrate" Width="100" x:Name="BitrateColumn"
                                        DisplayMemberBinding="{Binding BitrateText}"/>

                        <GridViewColumn Header="Dimensions" Width="110" x:Name="DimensionsColumn"
                                        DisplayMemberBinding="{Binding DimensionsText}"/>

                        <!-- Of programs and libraries (exe, dll ...), from their version information, as in Explorer's Details. -->
                        <GridViewColumn Header="Product Name" Width="150" x:Name="ProductNameColumn"
                                        DisplayMemberBinding="{Binding ProductName}"/>

                        <GridViewColumn Header="Product Version" Width="120" x:Name="ProductVersionColumn"
                                        DisplayMemberBinding="{Binding ProductVersion}"/>

                        <!-- The user's own rating and expectation (1-10, Ctrl+R and Ctrl+E), as in TeraTool. Hidden until used. -->
                        <GridViewColumn Header="Rating" Width="80" x:Name="RatingColumn"
                                        DisplayMemberBinding="{Binding RatingText}"/>

                        <GridViewColumn Header="Expectation" Width="100" x:Name="ExpectationColumn"
                                        DisplayMemberBinding="{Binding ExpectationText}"/>
                    </GridView>
                </ListView.View>

                <!-- Context menu — DataContext routed via Tag -->
                <ListView.ContextMenu>
                    <ContextMenu x:Name="FileContextMenu" Opened="ContextMenu_Opened">
                        <MenuItem Header="Open"       Click="CtxOpen_Click"/>
                        <MenuItem Header="Edit" Click="CtxEdit_Click"/>
                        <MenuItem Header="Open With..." Click="CtxOpenWith_Click"/>
                        <MenuItem Header="Open in New Tab" Click="CtxOpenInNewTab_Click"/>
                        <MenuItem Header="Open in Windows Explorer" Click="CtxExplorer_Click"
                                  ToolTip="Open this folder in Windows' own File Explorer (a selected file is shown selected in its folder)"/>
                        <MenuItem Header="Send to"    x:Name="SendToMenu" PreviewMouseRightButtonUp="SendToMenu_RightClick"
                                  ToolTip="Right-click to edit this menu"/>
                        <MenuItem Header="Add to Bookmarks" Click="CtxBookmark_Click" InputGestureText="Ctrl+D"
                                  ToolTip="Keep a shortcut to the selected folders and files (or to this folder) in the Bookmarks at the top of the tree"/>
                        <!-- Send to VirusTotal: a group of its own (one file only; the icon is set in code) -->
                        <Separator x:Name="ListVirusTotalSeparator" Visibility="Collapsed"/>
                        <MenuItem x:Name="ListVirusTotalItem" Header="Send to VirusTotal" Click="CtxVirusTotal_Click" Visibility="Collapsed"
                                  ToolTip="Look up this file on VirusTotal: its SHA-256 is worked out and VirusTotal's page for it opens in your browser. Nothing is uploaded."/>
                        <Separator/>
                        <MenuItem Header="Cut"        Click="CtxCut_Click"       InputGestureText="Ctrl+X"/>
                        <MenuItem Header="Copy"       Click="CtxCopy_Click"      InputGestureText="Ctrl+C"/>
                        <MenuItem Header="Paste"      Click="CtxPaste_Click"     InputGestureText="Ctrl+V"/>
                        <MenuItem Header="Copy as Path" Click="CtxCopyPath_Click" InputGestureText="Ctrl+Shift+C"
                                  ToolTip="Copy the full path of the selected items as text, each in quotes"/>
                        <MenuItem Header="Move/Copy to Folder..." Click="CtxMoveCopyTo_Click" InputGestureText="Ctrl+M"
                                  ToolTip="Move or copy the selected items to a folder you choose"/>
                        <MenuItem Header="Create Shortcut..." Click="CtxCreateShortcut_Click"
                                  ToolTip="Make a shortcut to the selected items in a folder you choose"/>
                        <MenuItem Header="Create Playlist..." Click="CtxCreatePlaylist_Click"
                                  ToolTip="Make an M3U playlist in this folder, with all the files, the selected files or none to start with"/>
                        <Separator/>
                        <MenuItem Header="Delete"     Click="CtxDelete_Click"    InputGestureText="Del"/>
                        <MenuItem Header="Rename..."  Click="CtxRename_Click"    InputGestureText="F2"/>
                        <MenuItem Header="Rename All Selected Music Files and Video Files Using Smart Rename" Click="CtxSmartRenameAll_Click"
                                  ToolTip="Every selected music file and video file gets the name that Rename suggests with Use Smart Name (Artist - Title, Title (Year), Title - s01e02). Asks first, and can be undone until another folder is shown."/>
                        <Separator/>
                        <MenuItem Header="Mark as Read"   Click="CtxMarkRead_Click"
                                  ToolTip="Remember that the selected files have been opened"/>
                        <MenuItem Header="Mark as Unread" Click="CtxMarkUnread_Click"
                                  ToolTip="Forget that the selected files have been opened"/>
                        <MenuItem Header="Jump to Last Opened File" Click="CtxJumpLast_Click"
                                  ToolTip="Select the file that was opened last in this folder"/>
                        <Separator/>
                        <MenuItem Header="Rating..."      Click="CtxRating_Click"      InputGestureText="Ctrl+R"
                                  ToolTip="Your rating of the selected items, 1 to 10. Leave it empty to remove it."/>
                        <MenuItem Header="Expectation..." Click="CtxExpectation_Click" InputGestureText="Ctrl+E"
                                  ToolTip="How good you expect the selected items to be, 1 to 10 (decimals allowed). Leave it empty to remove it."/>
                        <!-- Open a terminal in the selected folder, or in this folder (see the tree's menu) -->
                        <Separator x:Name="ListTerminalSeparator"/>
                        <MenuItem x:Name="ListTerminalItem"   Header="Open in Terminal"       Tag="WindowsTerminal" Click="CtxTerminal_Click" PreviewMouseRightButtonUp="CtxTerminal_RightClick"
                                  ToolTip="Right-click to open it as the administrator"/>
                        <MenuItem x:Name="ListPowerShellItem" Header="Open in PowerShell"      Tag="PowerShell"      Click="CtxTerminal_Click" PreviewMouseRightButtonUp="CtxTerminal_RightClick"
                                  ToolTip="Right-click to open it as the administrator"/>
                        <MenuItem x:Name="ListCommandItem"    Header="Open in Command Prompt"  Tag="CommandPrompt"   Click="CtxTerminal_Click" PreviewMouseRightButtonUp="CtxTerminal_RightClick"
                                  ToolTip="Right-click to open it as the administrator"/>
                        <Separator/>
                        <MenuItem Header="New Folder" Click="CtxNewFolder_Click" InputGestureText="Ctrl+Shift+N"/>
                        <MenuItem Header="New Text Document..." Click="CtxNewTextDocument_Click"
                                  ToolTip="Make an empty text file (.txt) in this folder. Cancel makes no file."/>
                        <MenuItem Header="New File from Clipboard" Click="CtxNewFileFromClipboard_Click"
                                  ToolTip="Make a text file (.txt) of the text on the clipboard, or a picture file (.png) of the picture on it. You can change the name; Cancel throws the file away."/>
                        <Separator/>
                        <MenuItem x:Name="ListFileInfoItem" Header="File Info Viewer" Click="CtxFileInfo_Click" Visibility="Collapsed"
                                  ToolTip="Show everything about the selected file in File Info Viewer"/>
                        <MenuItem Header="Properties" Click="CtxProperties_Click" InputGestureText="Alt+Enter"/>
                        <Separator/>
                        <MenuItem Header="More Options" Click="CtxMoreOptions_Click"
                                  ToolTip="The full Windows menu of the selected items (or of this folder when nothing is selected), with 7-Zip and the other add-ons. Shift + right-click opens it at once."/>
                    </ContextMenu>
                </ListView.ContextMenu>

            </ListView>
            </Grid>
            </DockPanel>

            <!-- Under the list: which item is selected, the hidden items, and a preview of a picture -->
            <!-- 117 = 1 (top line) + 8 + 100 (the preview box) + 8: with 116 the bottom line of the box was cut off -->
            <!-- The divider above the info panel: drag it up to make the panel (and the preview picture) bigger. A Thumb, not a
                 GridSplitter: the list row is a star row and the panel row a fixed one, which a GridSplitter mixes up. -->
            <!-- It is not drawn (no band: the user wanted the line only, as under the tree): it is an invisible strip over the top
                 5 px of the panel, whose own 1 px top border is the line. The row between the list and the panel is empty. -->
            <Thumb x:Name="InfoDivider" Grid.Column="2" Grid.Row="2" Height="5" Cursor="SizeNS"
                   VerticalAlignment="Top" Panel.ZIndex="2"
                   DragDelta="InfoDivider_DragDelta" DragCompleted="InfoDivider_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border x:Name="InfoPanel" Grid.Column="2" Grid.Row="2" Padding="10,8" ContextMenuOpening="InfoPanel_ContextMenuOpening"
                    Background="{DynamicResource PaneBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>   <!-- the info line: which file, how many hidden items -->
                        <RowDefinition Height="Auto"/> <!-- the Play bar (hidden until the Play button is pressed) -->
                        <RowDefinition Height="*"/>    <!-- the preview picture and the plot -->
                    </Grid.RowDefinitions>
                    <!-- Everything under the info line: the details, the preview picture, the plot, the AI information, the seed and the web origin.
                         The "x" at the far right hides it all (MainWindow.UpdateInfoPanelVisibility). -->
                    <Grid x:Name="InfoBody" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="InfoContent" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="220"/>   <!-- the details block (MainWindow.Details.cs) -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition x:Name="PlotColumn" Width="*"/>   <!-- the plot (set in code: MainWindow.LayoutInfoColumns) -->
                                <ColumnDefinition x:Name="AiInfoColumn" Width="0"/>   <!-- the prompt and negative prompt of an AI picture or video -->
                                <ColumnDefinition x:Name="InfoRightColumn" Width="0"/>   <!-- the seed and what the web says about the file (Mark of the Web) -->
                            </Grid.ColumnDefinitions>
                            <!-- The details of the selected item (name, then rows that fit its kind), left of the preview picture, as Explorer's Details pane.
                                 Filled in code (MainWindow.Details.cs); scrolls when the panel is too low for all the rows. -->
                            <Grid x:Name="DetailsPane" Grid.Column="0" MinWidth="220" MaxWidth="300" Margin="0,0,8,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel x:Name="DetailsPanel"/>
                                </ScrollViewer>

                                <!-- Small buttons in the lower left corner, with a tooltip only: Properties (a wrench, as in Explorer) and File Info Viewer (its own icon, set in code) -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="DetailsPropertiesButton" Click="DetailsProperties_Click" Focusable="False" Padding="7,4" Margin="0,0,6,0" ToolTip="Properties">
                                        <TextBlock Text="&#xE90F;" FontSize="14" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                    </Button>
                                    <Button x:Name="DetailsFileInfoButton" Click="DetailsFileInfo_Click" Focusable="False" Padding="7,4" Margin="0,0,6,0" ToolTip="File Info Viewer" Visibility="Collapsed">
                                        <Image x:Name="DetailsFileInfoIcon" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <!-- The plot from the video's .nfo file, to the right of the preview picture, only when there is one
                                 (it takes no space otherwise). A long plot scrolls; the whole text is also in the tooltip. -->
                            <Grid x:Name="PlotArea" Grid.Column="2" Margin="16,0,0,0" Background="Transparent" Visibility="Collapsed"
                                  PreviewMouseLeftButtonDown="PlotArea_PreviewMouseLeftButtonDown"
                                  ContextMenuOpening="PlotArea_ContextMenuOpening">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit Plot..." Click="PlotEdit_Click"
                                                  ToolTip="Change the plot of this file, which is kept in its .nfo file (a double-click does the same)"/>
                                        <MenuItem x:Name="PlotEditNfoItem" Header="Edit NFO File" Click="PlotEditNfo_Click" Visibility="Collapsed"
                                                  ToolTip="Open the .nfo file of this video or music file in the text editor"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <ScrollViewer x:Name="PlotScroll" Visibility="Collapsed"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="PlotText" FontSize="14" TextWrapping="Wrap"/>
                                </ScrollViewer>
                                <!-- Where there is no plot yet: a hint, so the user sees that a double-click adds one -->
                                <TextBlock x:Name="PlotHint" FontSize="14" Text="Double-click to add a plot" Visibility="Collapsed"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                            </Grid>
                            <!-- What an AI program wrote into a PNG or MP4 (prompt, negative prompt, seed), right of the plot column.
                                 Read-only text boxes, so the text can be selected and copied; each scrolls by itself when the text is long. -->
                            <Grid x:Name="AiInfoArea" Grid.Column="3" Margin="16,0,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*" MinWidth="50"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="AiPromptLabel" Grid.Column="0" FontSize="12" FontWeight="Bold" Text="Prompt" Margin="0,0,0,2"/>
                                <TextBox x:Name="AiPromptBox" Grid.Column="0" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="2" BorderThickness="0" PreviewKeyDown="AiTextBox_PreviewKeyDown">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="AiCopySelected_Click"
                                                      ToolTip="Copies all the text when nothing is selected"/>
                                            <MenuItem Header="Copy All Text" Click="AiCopyAll_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Select All Files with This Prompt" Click="AiSelectSamePrompt_Click"
                                                      ToolTip="Selects the files of the same type in this folder whose prompt has the same letters (spaces, punctuation and case are ignored)"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>

                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" Text="Negative Prompt" Margin="0,0,0,2"/>
                                <TextBox x:Name="AiNegativeBox" Grid.Column="2" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="2" BorderThickness="0" PreviewKeyDown="AiTextBox_PreviewKeyDown">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="AiCopySelected_Click"
                                                      ToolTip="Copies all the text when nothing is selected"/>
                                            <MenuItem Header="Copy All Text" Click="AiCopyAll_Click"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </Grid>
                            <!-- The right-hand part of the panel: the seed of an AI picture, and what the web says about the file (the Mark of the Web
                                 that browsers attach to a download: zone, address of the file, page it came from). Single-line read-only text boxes (the
                                 whole text is copied by Ctrl+C or the menu); a row without a value is not shown; read in the background (MainWindow.ShowWebOrigin). -->
                            <Grid x:Name="InfoRightArea" Grid.Column="4" Margin="16,0,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="AiSeedLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="12" FontWeight="Bold" Text="Seed"
                                           VerticalAlignment="Top" Margin="0,0,0,2" Visibility="Collapsed"/>
                                <TextBox x:Name="AiSeedBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True" TextWrapping="NoWrap" FontSize="13"
                                         Height="26" VerticalAlignment="Top" VerticalContentAlignment="Top" Visibility="Collapsed"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Background="Transparent" Padding="2" BorderThickness="0"
                                         PreviewKeyDown="AiSeedBox_PreviewKeyDown">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="AiCopyAll_Click"
                                                      ToolTip="Copies the whole text"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>

                                <TextBlock x:Name="WebZoneLabel" Grid.Row="2" Grid.Column="0" FontSize="12" FontWeight="Bold" Text="Zone ID"
                                           VerticalAlignment="Top" Margin="0,5,10,0" Visibility="Collapsed"/>
                                <TextBox x:Name="WebZoneBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" TextWrapping="NoWrap" FontSize="13"
                                         Height="26" VerticalAlignment="Top" VerticalContentAlignment="Top" Visibility="Collapsed"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Background="Transparent" Padding="2" BorderThickness="0"
                                         PreviewKeyDown="AiSeedBox_PreviewKeyDown">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="AiCopyAll_Click"
                                                      ToolTip="Copies the whole text"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>

                                <TextBlock x:Name="WebHostLabel" Grid.Row="3" Grid.Column="0" FontSize="12" FontWeight="Bold" Text="Host URL"
                                           VerticalAlignment="Top" Margin="0,5,10,0" Visibility="Collapsed"/>
                                <TextBox x:Name="WebHostBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" TextWrapping="NoWrap" FontSize="13"
                                         Height="26" VerticalAlignment="Top" VerticalContentAlignment="Top" Visibility="Collapsed"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Background="Transparent" Padding="2" BorderThickness="0"
                                         PreviewKeyDown="AiSeedBox_PreviewKeyDown"
                                         MouseDoubleClick="WebUrlBox_DoubleClick" ContextMenuOpening="WebUrlBox_ContextMenuOpening">
                                </TextBox>

                                <TextBlock x:Name="WebReferrerLabel" Grid.Row="4" Grid.Column="0" FontSize="12" FontWeight="Bold" Text="Referrer URL"
                                           VerticalAlignment="Top" Margin="0,5,10,0" Visibility="Collapsed"/>
                                <TextBox x:Name="WebReferrerBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True" TextWrapping="NoWrap" FontSize="13"
                                         Height="26" VerticalAlignment="Top" VerticalContentAlignment="Top" Visibility="Collapsed"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Background="Transparent" Padding="2" BorderThickness="0"
                                         PreviewKeyDown="AiSeedBox_PreviewKeyDown"
                                         MouseDoubleClick="WebUrlBox_DoubleClick" ContextMenuOpening="WebUrlBox_ContextMenuOpening">
                                </TextBox>

                                <!-- Audio Source: the page of a music file (the WOAS tag of an MP3, or the song id in a Suno WAV's comment; AudioSourceReader). -->
                                <TextBlock x:Name="AudioSourceLabel" Grid.Row="5" Grid.Column="0" FontSize="12" FontWeight="Bold" Text="Audio Source"
                                           VerticalAlignment="Top" Margin="0,5,10,0" Visibility="Collapsed"/>
                                <TextBox x:Name="AudioSourceBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" TextWrapping="NoWrap" FontSize="13"
                                         Height="26" VerticalAlignment="Top" VerticalContentAlignment="Top" Visibility="Collapsed"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Background="Transparent" Padding="2" BorderThickness="0"
                                         PreviewKeyDown="AiSeedBox_PreviewKeyDown"
                                         MouseDoubleClick="WebUrlBox_DoubleClick" ContextMenuOpening="WebUrlBox_ContextMenuOpening">
                                </TextBox>
                            </Grid>
                            <!-- The map symbol in the lower right corner: only when the selected picture or video says where it was taken
                                 (read in the background, MainWindow.ShowGps). A click shows the place on Google Maps; the right-click menu can copy
                                 the coordinates. A Windows symbol font glyph (Segoe Fluent Icons), so it follows the style and needs no picture file. -->
                            <Border x:Name="GpsButton" Grid.Column="0" Grid.ColumnSpan="5" Width="34" Height="34" Margin="0,0,2,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="Hand"
                                    Visibility="Collapsed" Panel.ZIndex="3" MouseLeftButtonUp="GpsButton_MouseLeftButtonUp">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Show on Google Maps" Click="GpsOpen_Click"/>
                                        <MenuItem Header="Show on OpenStreetMap" Tag="osm" Click="GpsSite_Click"/>
                                        <MenuItem Header="Show on Bing Maps" Tag="bing" Click="GpsSite_Click"/>
                                        <MenuItem Header="Show on Waze" Tag="waze" Click="GpsSite_Click"
                                                  ToolTip="Opens Waze with a route to the place"/>
                                        <MenuItem Header="Show on Apple Maps" Tag="apple" Click="GpsSite_Click"/>
                                        <MenuItem Header="Show on HERE WeGo" Tag="here" Click="GpsSite_Click"/>
                                        <MenuItem Header="Show on MapQuest" Tag="mapquest" Click="GpsSite_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Copy Coordinates" Click="GpsCopy_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                                           Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- A click opens the picture in the picture viewer (the picture of a picture file, the cover built into a
                                 music file, the preview picture of a video). The transparent border is there so that the right-click
                                 menu (Choose / No / Automatic preview picture) also works on an empty square. -->
                            <Border x:Name="PreviewBox" Grid.Column="1" Width="160" Height="100" Background="Transparent"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    ContextMenuOpening="PreviewBox_ContextMenuOpening">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="PreviewChooseItem" Header="Choose Preview Picture..." Click="PreviewChoose_Click"/>
                                        <MenuItem x:Name="PreviewNoneItem"   Header="No Preview Picture"        Click="PreviewNone_Click"/>
                                        <MenuItem x:Name="PreviewAutoItem"   Header="Use Automatic Preview Picture" Click="PreviewAuto_Click"/>
                                        <Separator x:Name="PreviewSaveSeparator"/>
                                        <MenuItem x:Name="PreviewSaveItem"   Header="Save Preview Picture As..." Click="PreviewSave_Click"/>
                                        <Separator x:Name="FolderPictureSeparator"/>
                                        <MenuItem x:Name="FolderPictureSetItem"  Header="Set as Folder Picture" Click="FolderPictureSet_Click"
                                                  ToolTip="Show this picture under the folder tree for this folder. Only its name is kept in the library; no file is made."/>
                                        <MenuItem x:Name="FolderPictureAutoItem" Header="Use Automatic Folder Picture" Click="FolderPictureAuto_Click"
                                                  ToolTip="Forget the chosen picture of this folder: the program looks for one itself again"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Image x:Name="ThumbnailImage" Stretch="Uniform" Cursor="Hand"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseLeftButtonDown="ThumbnailImage_MouseLeftButtonDown"/>
                                    <!-- Shown instead of the picture for a video or music file that has none (or is set to none),
                                         so the user sees where to right-click -->
                                    <TextBlock x:Name="PreviewEmptyText" Text="No Preview Picture" Visibility="Collapsed"
                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- The "x" far right, beyond the seed: hides the whole panel under the info line (the preview picture, the details, the
                             plot ...). A small button at the right end of the info line brings it back (as for the folder picture under the tree). -->
                        <Button x:Name="InfoCloseButton" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Focusable="False" Padding="6,2" Margin="8,0,0,0"
                                ToolTip="Hide the Panel (a button at the right end of the line above shows it again)" Click="InfoClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                        </Button>
                    </Grid>






                    <!-- A row of its own above the picture and the plot: where the selected file is in the list (or how many are
                         selected / in the folder), and the hidden-items link well to the right of it -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock x:Name="PositionText" FontSize="12"/>

                        <TextBlock FontSize="12" Margin="84,0,16,0"
                                   Visibility="{Binding HasHiddenItems, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Click to show or hide the hidden and system items of this folder">
                            <Hyperlink Command="{Binding ToggleHiddenCommand}">
                                <Run Text="{Binding HiddenText, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>

                        <!-- Everything shown is selected, but the folder has hidden items that are not shown: they would be left out of a copy or move
                             (MainWindow.UpdateHiddenWarning; Settings > Files > Hidden Files) -->
                        <TextBlock x:Name="HiddenWarning" FontSize="12" FontWeight="SemiBold" Foreground="#E5484D" Margin="0,0,16,0" Visibility="Collapsed"
                                   ToolTip="Ctrl+C, Ctrl+X and dragging only take what is selected. Click the hidden-items link to show them, then select all again."/>

                        <!-- What Ctrl+D (or Add to Bookmarks) just did, with a link to the Bookmarks: stays until another folder or file is
                             clicked (MainWindow.ShowBookmarkNote / HideBookmarkNote) -->
                        <TextBlock x:Name="BookmarkNote" FontSize="12" Margin="30,0,16,0" Visibility="Collapsed">
                            <Run x:Name="BookmarkNoteText"/>
                            <Run Text="   "/>
                            <Hyperlink x:Name="BookmarkNoteLink" TextDecorations="Underline" Click="BookmarkNoteLink_Click"
                                       ToolTip="Show the Bookmarks in the tree and select this bookmark"><Run Text="Go to Bookmarks now?"/></Hyperlink>
                        </TextBlock>

                        <!-- Undo of the last file operation (delete, rename, move, copy, new folder / file): one step for the whole program, see Helpers/FileUndo.cs -->
                        <Button x:Name="UndoButton" Content="{Binding UndoText}" Height="20" MinHeight="0" Padding="9,0" FontSize="12" Margin="0,0,6,0"
                                VerticalAlignment="Top" Click="UndoLast_Click"
                                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{Binding UndoTip}"/>

                        <!-- The playlist buttons: only while a playlist is shown (MainWindow.Playlist.cs) -->
                        <StackPanel x:Name="PlaylistBar" Orientation="Horizontal" Margin="130,0,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <Button x:Name="PlaylistAddButton" Content="Add Files..." Height="20" MinHeight="0" Padding="9,0" FontSize="12" Margin="0,0,6,0"
                                    Click="PlaylistAdd_Click"
                                    ToolTip="Add files to the playlist, after the selected one. Copying files and pasting them here (Ctrl+V) does the same."/>
                            <Button x:Name="PlaylistUpButton" Content="&#x25B2;" FontFamily="Segoe UI Symbol" Height="20" MinHeight="0" MinWidth="30" Padding="6,0" FontSize="11" Margin="0,0,3,0"
                                    Click="PlaylistUp_Click" ToolTip="Move Up (the selected files one place up in the playlist)"/>
                            <Button x:Name="PlaylistDownButton" Content="&#x25BC;" FontFamily="Segoe UI Symbol" Height="20" MinHeight="0" MinWidth="30" Padding="6,0" FontSize="11" Margin="0,0,12,0"
                                    Click="PlaylistDown_Click" ToolTip="Move Down (the selected files one place down in the playlist)"/>
                            <Button x:Name="PlaylistSaveButton" Content="Save Playlist" Height="20" MinHeight="0" Padding="9,0" FontSize="12" Margin="0,0,6,0"
                                    Click="PlaylistSave_Click" ToolTip="Save the playlist (Ctrl+S)"/>
                            <Button x:Name="PlaylistSaveAsButton" Content="Save Playlist As..." Height="20" MinHeight="0" Padding="9,0" FontSize="12" Margin="0,0,0,0"
                                    Click="PlaylistSaveAs_Click" ToolTip="Save the playlist as another file"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Scroll the file list to the very top / bottom (MainWindow.ScrollList): at the right end of the info line -->
                    <StackPanel x:Name="ScrollButtons" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0">
                        <Button x:Name="ScrollTopButton" Height="20" MinHeight="0" MinWidth="34" Padding="6,0" Margin="0,0,3,0"
                                Focusable="False" Click="ScrollTop_Click" ToolTip="Scroll the List to the Top">
                            <Path Width="10" Height="10" Stretch="Fill" Data="M0,0 H10 V1.5 H0 Z M5,3.5 L10,10 H0 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="ScrollBottomButton" Height="20" MinHeight="0" MinWidth="34" Padding="6,0"
                                Focusable="False" Click="ScrollBottom_Click" ToolTip="Scroll the List to the Bottom">
                            <Path Width="10" Height="10" Stretch="Fill" Data="M0,8.5 H10 V10 H0 Z M0,0 H10 L5,6.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>

                    <!-- The Play bar, as TeraTool's box under the list, with one change: Play and Pause are one button. Under the info line,
                         above the preview picture; wraps onto a second line in a narrow window. Phase 1 plays pictures (see docs/slideshow-and-play-modes-plan.md). -->
                    <!-- Only there while the panel under this line is hidden: shows it again -->
                    <Button x:Name="InfoPanelShowButton" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False" Padding="6,2" Margin="0,0,2,0"
                            Visibility="Collapsed" ToolTip="Show the Panel under This Line (the preview picture and the details)" Click="InfoPanelShow_Click">
                        <TextBlock Text="&#xE946;" FontSize="13" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </Button>

                    <Border x:Name="PlayBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed" Padding="0,2,0,4">
                        <DockPanel LastChildFill="True">
                        <!-- The "x" at the far right (the first right-docked item is the outermost): hides the Play bar, like the toolbar's Play
                             button and Ctrl+P. Red under the mouse, as the other close buttons. -->
                        <Button x:Name="PlayBarCloseButton" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False" Padding="6,2" Margin="8,0,0,0"
                                ToolTip="Hide the Play Bar (the Play button in the toolbar or Ctrl+P shows it again)" Click="PlayBarClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Box" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="&#x2715;" FontSize="11" FontFamily="Segoe UI"/>
                        </Button>
                        <Button x:Name="ShowPlayerButton" DockPanel.Dock="Right" Click="ShowPlayer_Click" Content="Show Media Player" FontSize="12" Padding="12,2" Margin="8,2,0,2"
                                ToolTip="Bring SweWolf Media Player to the front (and back from the taskbar if it was minimized)"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Click="PlayButton_Click" ToolTip="Play the pictures of the list from the selected one" Padding="12,2" Margin="0,2,4,2" MinWidth="76">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="PlayButtonIcon" Data="M0,0 L10.5,6 L0,12 Z" Width="10.5" Height="12" Stretch="Fill" SnapsToDevicePixels="True" Margin="0,0,7,0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock x:Name="PlayButtonText" Text="Play" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PlayStopButton" Click="PlayStop_Click" ToolTip="Stop: close SweWolf Media Player and end the list" Padding="12,0" Height="{Binding ActualHeight, ElementName=PlayButton}" Margin="0,2,4,2">
                                <Path Data="M0,0 H11 V11 H0 Z" Width="11" Height="11" Stretch="Fill" SnapsToDevicePixels="True"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="PlayPreviousButton" Click="PlayPrevious_Click" ToolTip="Previous File" Padding="12,0" Height="{Binding ActualHeight, ElementName=PlayButton}" Margin="0,2,4,2">
                                <Path Data="M0,0 H2.5 V12 H0 Z M2.5,6 L13,0 V12 Z" Width="13" Height="12" Stretch="Fill" SnapsToDevicePixels="True"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="PlayNextButton" Click="PlayNext_Click" ToolTip="Next File" Padding="12,0" Height="{Binding ActualHeight, ElementName=PlayButton}" Margin="0,2,0,2">
                                <Path Data="M10.5,0 H13 V12 H10.5 Z M10.5,6 L0,0 V12 Z" Width="13" Height="12" Stretch="Fill" SnapsToDevicePixels="True"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>

                            <TextBlock Text="Play Mode" FontSize="12" Margin="12,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PlayModeBox" Width="146" FontSize="12" Margin="0,2,0,2" SelectionChanged="PlaySetting_Changed"
                                      ToolTip="Continuous Play (Slide Show): the next file comes by itself.&#10;&#10;Single Play: the file opens and stays.&#10;&#10;Repeat: the same music or video plays again and again.&#10;&#10;Demo Play: each music or video file plays for the time below, from 1 minute in.&#10;&#10;Intro Play: the same, from the start.&#10;&#10;Random Order: Play puts the files in a random order and plays them from the top.">
                                <ComboBoxItem Content="Continuous Play"/>
                                <ComboBoxItem Content="Single Play"/>
                                <ComboBoxItem Content="Repeat"/>
                                <ComboBoxItem Content="Demo Play"/>
                                <ComboBoxItem Content="Intro Play"/>
                                <ComboBoxItem Content="Random Order"/>
                            </ComboBox>

                            <TextBlock Text="Time per File (s)" FontSize="12" Margin="12,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlaySecondsBox" Width="80" MinWidth="80" FontSize="12" Margin="0,2,0,2" MaxLength="4" TextAlignment="Right"
                                     PreviewTextInput="PlayNumber_PreviewTextInput" LostFocus="PlayNumber_LostFocus"
                                     ToolTip="How many seconds each picture stays in a slide show, and how long each music or video file plays in Demo Play and Intro Play (10 if this is not a positive number)"/>

                            <TextBlock Text="End of List Action" FontSize="12" Margin="12,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PlayEndBox" Width="160" FontSize="12" Margin="0,2,0,2" SelectionChanged="PlaySetting_Changed"
                                      ToolTip="What a slide show does after the last picture">
                                <ComboBoxItem Content="Go to Next Folder"/>
                                <ComboBoxItem Content="Start from Beginning"/>
                                <ComboBoxItem Content="Close"/>
                            </ComboBox>

                            <CheckBox x:Name="PlayAskBox" Content="Ask First" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                      Checked="PlaySetting_Changed" Unchecked="PlaySetting_Changed"
                                      ToolTip="Ask at the end of the list what to do. The action above is taken by itself when the time-out is over."/>
                            <TextBlock Text="Time-out (s)" FontSize="12" Margin="10,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlayTimeoutBox" Width="74" MinWidth="74" FontSize="12" Margin="0,2,0,2" MaxLength="3" TextAlignment="Right"
                                     PreviewTextInput="PlayNumber_PreviewTextInput" LostFocus="PlayNumber_LostFocus"
                                     ToolTip="Seconds before the question at the end of the list takes the action above by itself (0 = wait for the answer)"/>
                        </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- The line under the Play bar (the continuous playing row): drag it to change the height of the panel, as the other lines. -->
                    <Thumb x:Name="PlayLineDivider" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="5" Cursor="SizeNS"
                           VerticalAlignment="Bottom" Margin="-10,0,-10,0" Visibility="Collapsed"
                           DragDelta="InfoDivider_DragDelta" DragCompleted="InfoDivider_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>


                    <!-- A second line, under the info line (File 12/17 ...), that does the same as the one above the panel: drag it to
                         change the height of the panel. The info line itself keeps its height. It lies over the bottom of the info
                         line's row, so nothing moves, and reaches to the edges of the panel (the panel has a padding). -->
                    <Thumb x:Name="InfoLineDivider" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Height="5" Cursor="SizeNS"
                           VerticalAlignment="Bottom" Margin="-10,0,-10,0"
                           DragDelta="InfoDivider_DragDelta" DragCompleted="InfoDivider_DragCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <!-- Only the 1 px line (as above the panel and under the tree); the rest of the 5 px is the grip -->
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>

            <!-- Status bar: under the list and the info panel, as what it says is about the list -->
            <!-- Only there while it has a message (an error, "Marking as read..."): the number of items is in the info panel -->
            <StatusBar Grid.Column="2" Grid.Row="3" MinHeight="24"
                       Visibility="{Binding StatusText, Converter={StaticResource TextToVisibility}}">
                <StatusBarItem>
                    <!-- The status bar has no theme of its own: without this the text is black on the dark styles. -->
                    <TextBlock Text="{Binding StatusText}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF5A5A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StatusBarItem>
            </StatusBar>
        </Grid>

    </DockPanel>
</Window>
