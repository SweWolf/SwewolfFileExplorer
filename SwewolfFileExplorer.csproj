<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwewolfFileExplorer</AssemblyName>
    <RootNamespace>SwewolfFileExplorer</RootNamespace>
    <Platforms>x64</Platforms>
    <!-- Windows x64 only: without this, SkiaSharp (SVG pictures) and SQLite copy their native libraries for every operating
         system into the output (a folder of 450 MB instead of about 50 MB). The output stays in bin\x64\Release\net10.0-windows. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <StartupObject>SwewolfFileExplorer.Program</StartupObject>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Resourses\fluent_file_explorer.ico</ApplicationIcon>
    <!-- What Explorer shows in the EXE's Properties > Details: File description, Product name, Comments, Copyright. -->
    <AssemblyTitle>SweWolf File Explorer</AssemblyTitle>
    <Product>SweWolf File Explorer</Product>
    <Description>A file manager with tabs, a folder tree, bookmarks, an information panel and archives as folders.</Description>
    <Company>SweWolf Software</Company>
    <Copyright>SweWolf Software</Copyright>
    <Authors>SweWolf</Authors>
    <!-- WPF0001: Application.ThemeMode (the Fluent light/dark theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tags of music files (Artist, Title, Track Number columns). The same package and version as FileInfoViewer. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Help > SweWolf File Explorer Help (F1). Rebuild it from help.md with docs\build-help.cmd -->
    <Content Include="docs\help.html" Link="Help\help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Also embedded in the EXE: HelpFiles.cs saves it to %AppData% and opens it when the Help
         folder is missing (e.g. only the EXE was copied) -->
    <EmbeddedResource Include="docs\help.html">
      <LogicalName>Help/help.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Icons that FileTypes.json can name as "builtin:<file name without .ico>" (same look on every Windows version, also in the single-file EXE).
         Every .ico dropped in this folder is included. -->
    <!-- The program's own list of file type names and icons (Settings: Use SweWolf File Explorer's Own Definition ...). -->
    <EmbeddedResource Include="Resourses\FileTypes.default.json">
      <LogicalName>FileTypes.default.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resourses\FileTypeIcons\*.ico">
      <LogicalName>FileTypeIcons/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Nothing of Microsoft's is shipped: the default list uses "win11:" icons read from the user's own Windows 11. -->
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resourses\fluent_file_explorer.ico" />
    <!-- The splash screen is shown by our own Main (Program.cs), not by the generated one (a <SplashScreen> item): the administrator
         helper of Paste (elevated-transfer) is this same EXE and must start without it. -->
    <Resource Include="Resourses\splash.png" />
  </ItemGroup>

  <!-- The debug symbols of SkiaSharp's native libraries (106 MB) come along with them; nobody needs them. -->
  <Target Name="DropNativePdbs" AfterTargets="Build">
    <Delete Files="$(OutDir)libSkiaSharp.pdb;$(OutDir)libHarfBuzzSharp.pdb" ContinueOnError="true" />
  </Target>

  <!-- The same for a publish (both release kinds): the symbols of the native libraries are not published. -->
  <Target Name="DropNativePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libHarfBuzzSharp.pdb'" />
    </ItemGroup>
  </Target>

</Project>
