<Window x:Class="SwewolfFileExplorer.Views.ChooseDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Details"
        Width="420" Height="420" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>   <!-- as wide as the longest button (Move Down) -->
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" TextWrapping="Wrap"
                   Text="Select the details you want to display in the file list."/>

        <!-- Row 2: the list and the buttons beside it -->
        <ListBox x:Name="DetailsList" Grid.Row="2" Grid.Column="0"
                 SelectionChanged="DetailsList_SelectionChanged"
                 CheckBox.Checked="DetailsList_CheckChanged"
                 CheckBox.Unchecked="DetailsList_CheckChanged">
            <!-- The Fluent theme makes the items 40 px high: closer together, so more of the columns show without scrolling -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="MinHeight" Value="26"/>
                    <Setter Property="Padding"   Value="4,1"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Title}" MinHeight="0" VerticalContentAlignment="Center"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                              IsEnabled="{Binding CanHide}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Grid.Column="2">
            <Button x:Name="MoveUpButton"   Content="Move Up"   Padding="2,3" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="MoveUp_Click"/>
            <Button x:Name="MoveDownButton" Content="Move Down" Padding="2,3" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="MoveDown_Click"/>
            <Button x:Name="ShowButton"     Content="Show"      Padding="2,3" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="Show_Click"/>
            <Button x:Name="HideButton"     Content="Hide"      Padding="2,3" HorizontalAlignment="Stretch" Click="Hide_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal">
            <TextBlock Text="Width of Selected Column (in pixels):" VerticalAlignment="Center"/>
            <TextBox x:Name="WidthBox" Width="60" Margin="8,0,0,0" Padding="3"
                     Text="{Binding SelectedItem.Width, ElementName=DetailsList, UpdateSourceTrigger=LostFocus}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OkButton_Click"
                    BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" BorderThickness="2"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
