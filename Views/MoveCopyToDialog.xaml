<Window x:Class="SwewolfFileExplorer.Views.MoveCopyToDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move/Copy to Folder"
        Width="760" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- What is going to be moved or copied -->
        <TextBlock x:Name="SelectedText" Grid.Row="0" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"/>

        <!-- The two radio buttons come first in the tab order, with nothing between them (arrow keys move between them) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="MoveRadio" Content="Move" GroupName="Mode" IsChecked="True" TabIndex="0" Margin="0,0,60,0"/>
            <RadioButton x:Name="CopyRadio" Content="Copy" GroupName="Mode" TabIndex="1"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="FolderList" Grid.Column="0" TabIndex="2"
                     SelectionChanged="FolderList_SelectionChanged" MouseDoubleClick="FolderList_MouseDoubleClick"
                     ToolTip="Your folders. Click one to use it, double-click to use it at once."/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="150">
                <Button x:Name="AddButton" Content="Add Folder..." HorizontalAlignment="Stretch" TabIndex="3" Padding="8,6" Margin="0,0,0,10" Click="AddButton_Click"
                        ToolTip="Add a folder to the list"/>
                <Button x:Name="RemoveButton" Content="Remove from List" HorizontalAlignment="Stretch" TabIndex="4" Padding="8,6" Margin="0,0,0,10" Click="RemoveButton_Click"
                        ToolTip="Take the selected folder out of the list (the folder itself is not touched)"/>
                <Button x:Name="UpButton" Content="&#x25B2;" HorizontalAlignment="Center" TabIndex="5" Width="44" Height="34" Margin="0,0,0,6" Click="UpButton_Click"
                        ToolTip="Move up"/>
                <Button x:Name="DownButton" Content="&#x25BC;" HorizontalAlignment="Center" TabIndex="6" Width="44" Height="34" Click="DownButton_Click"
                        ToolTip="Move down"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Text="Folder" Margin="0,14,0,4"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" Grid.Column="0" TabIndex="7" Padding="3" TextChanged="FolderBox_TextChanged"/>
            <Button Grid.Column="1" Content="..." TabIndex="8" Margin="12,0,0,0" Padding="12,3" MinWidth="44" Click="BrowseButton_Click"
                    ToolTip="Browse for folder"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Says what will happen to a folder that is not there yet -->
            <TextBlock x:Name="HintText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="OK" TabIndex="9" MinWidth="110" Margin="0,0,10,0" IsDefault="True" Click="OkButton_Click"
                        BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" BorderThickness="2"/>
                <Button Content="Cancel" TabIndex="10" MinWidth="110" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
