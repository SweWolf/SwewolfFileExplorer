<Window x:Class="SwewolfFileExplorer.Views.PlotEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Plot"
        Width="680" Height="440" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <!-- Enter makes a new line in the text, so Ctrl+Enter is the way to OK from the keyboard (handled in the code) -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap"/>

        <TextBox x:Name="PlotBox" Grid.Row="2" Padding="4"
                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 SpellCheck.IsEnabled="True"/>

        <TextBlock x:Name="FileText" Grid.Row="4" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,8,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" BorderThickness="2"
                    Click="OkButton_Click"
                    ToolTip="Save the plot in the .nfo file (Ctrl+Enter)"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
