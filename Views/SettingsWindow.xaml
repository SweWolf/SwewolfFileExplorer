<Window x:Class="SwewolfFileExplorer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=StyleBox}">

    <Window.Resources>
        <!-- Tabs that look like the tabs of the main window: a 3 px accent line on top, a distinct background and bold text for the selected one. -->
        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,3,0,0" CornerRadius="6,6,0,0" Padding="18,6">
                            <ContentPresenter x:Name="TabContent" TextElement.Foreground="{TemplateBinding Foreground}" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter TargetName="TabContent" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A Grid, not a StackPanel: a StackPanel gives its children unlimited height, so the tabs could never scroll. The window's MaxHeight
         (set in code: the screen's working area) is what limits it; the tab pages scroll when they do not fit. -->
    <!-- MinWidth: the window sizes itself to the tab that is shown first, and the widest tab (Security, with the VirusTotal group, about 650 px
         plus margins) must fit too: the tab pages scroll up and down only. -->
    <Grid Margin="12" MinWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Appearance" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="StyleBox" Width="140"
                          ToolTip="Light, Dark, the same as Windows, or Cyber Cyan (light blue on black)">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Cyber Cyan"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Font" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="FontBox" Width="240" MaxDropDownHeight="360"
                          ToolTip="The font of the file list and the folder tree. Bold and italic are used for unread files, so they cannot be chosen here. The size is set with Ctrl + mouse wheel, or Ctrl+Plus and Ctrl+Minus."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Progress Bars" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SquareBarsBox" Content="Square" GroupName="BarLook" Margin="0,0,16,0"
                             ToolTip="The progress bar of a copy, move or delete has square corners"/>
                <RadioButton x:Name="RoundedBarsBox" Content="Rounded" GroupName="BarLook"
                             ToolTip="The progress bar of a copy, move or delete has rounded corners"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Unread Files" Padding="8" Margin="0,8,0,0"
                  ToolTip="How a file that has not been opened in this app yet looks in the file list">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="UnreadBoldBox"   Content="Bold"   Margin="0,0,16,0"/>
                <CheckBox x:Name="UnreadItalicBox" Content="Italic"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Drag and Drop" Padding="8" Margin="0,8,0,0">
            <CheckBox x:Name="DisableDragDropBox" Content="Disable Internal Drag and Drop"
                      ToolTip="On: files cannot be copied or moved by dragging them onto the list or the tree, and dragging with the right mouse button is off. Dragging a picture in from a web browser, and dragging files out of the list to a web browser or another program with the left button, always work."/>
        </GroupBox>
        <GroupBox Header="When the Program Is Started Again" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <ComboBox x:Name="StartAgainBox" HorizontalAlignment="Left" Width="300"
                          ToolTip="What happens when the program is started while it is already running (a shortcut, or another program that opens a folder or file here). If the running window cannot take it at that moment (a dialog is open, or it does not answer), a new window is opened anyway.">
                    <ComboBoxItem Content="Use the Running Window"/>
                    <ComboBoxItem Content="Start a New Window"/>
                    <ComboBoxItem Content="Ask"/>
                </ComboBox>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Opacity="0.7"
                           Text="In the running window, a folder opens in a new tab. If a session is on in that window, you are always asked first."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Updates" Padding="8" Margin="0,8,0,0">
            <CheckBox x:Name="CheckUpdatesBox" Content="Check for a New Version at Startup"
                      ToolTip="On: a few seconds after the program starts it asks GitHub whether a newer version has been released. If there is one, a link appears at the right end of the menu bar. Nothing is downloaded or installed, and nothing is sent except the request itself."/>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Files">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Hidden Files" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Hide Files with These Extensions:" Margin="0,0,0,4"/>
                <TextBox x:Name="HiddenExtensionsBox"
                         ToolTip="Separated by semicolons, for example bup;ifo;db. These files are listed as hidden items, like files with the Hidden attribute, and do not count when a folder is checked for being read."/>

                <TextBlock Text="Also Hide Files with These Extensions When Inside Compressed Files:" Margin="0,10,0,4"/>
                <TextBox x:Name="HiddenExtensionsInArchivesBox"
                         ToolTip="Separated by semicolons, for example nfo;txt;url. Only used inside zip, RAR and other compressed files (the files of the list above are hidden there too), for example the text files that come with a comic."/>

                <CheckBox x:Name="WarnHiddenNotSelectedBox" Content="Warn When All Files Are Selected but Hidden Items Are Not" Margin="0,10,0,0"
                          ToolTip="Shows a red warning next to the hidden-items link under the list when everything shown is selected (Ctrl+A) and the folder also has hidden items that are not shown. Copying or moving the selection leaves those items out."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="File Names" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="HideShellExtensionsBox" Content="Hide Extensions for Special Shell and System File Types (Recommended)"
                          ToolTip="As Windows does: a shortcut is shown as Photos, not Photos.lnk. This is about .lnk, .pif, .url, .scf, .desklink, .mapimail, .mydocs, .library-ms and .searchconnector-ms. The files are still listed, and renaming one keeps its extension."/>
                <CheckBox x:Name="HideKnownExtensionsBox" Content="Hide Extensions for Known File Types" Margin="0,8,0,0"
                          ToolTip="As Windows' Folder Options: a file is shown as Report, not Report.txt, when Windows knows its type. Off to begin with. The .ext button in the toolbar does the same. Renaming a file keeps its extension."/>
                <CheckBox x:Name="AlwaysShowTreeExtensionsBox" Content="Always Show Extensions for Files in the Folder Tree" Margin="0,8,0,0"
                          ToolTip="The folder tree lists packed files (.zip and others) and playlists (.m3u). On, their extension is always shown, which tells you they are files, not folders.&#10;Off, the tree hides the extension by the same rules as the list: special shell types, and known file types when Hide Extensions for Known File Types is on.&#10;A file keeps its extension when a folder or another file would get the same name."/>
                <CheckBox x:Name="OwnFileIconsBox" Content="Use SweWolf File Explorer's Own Definition of Icons (Recommended)" Margin="0,8,0,0"
                          ToolTip="Some file types (pictures, music, video) get the newer icons of Windows 11. Only available on Windows 11. A FileTypes.json of your own in %AppData%\SweWolfSoftware\SwewolfFileExplorer is always used on top of that. Off, the icons are as Windows Explorer shows them."/>
                <CheckBox x:Name="OwnFileTypesBox" Content="Use SweWolf File Explorer's Own Definition of File Type Names (Recommended)" Margin="0,8,0,0"
                          ToolTip="The Type column uses the names that come with SweWolf File Explorer, for example JPEG Image. A FileTypes.json of your own in %AppData%\SweWolfSoftware\SwewolfFileExplorer is always used on top of that. Off, only your own file and the choice below decide, and the rest is as Windows Explorer shows it."/>
                <CheckBox x:Name="RegisteredTypeNamesBox" Content="Show the Registered Name of Each File Type" Margin="0,8,0,0"
                          ToolTip="The Type column shows the name Windows has registered for the file type itself. Off, it shows the name Windows Explorer shows, which can depend on the program that opens the type.&#10;Only used for file types that SweWolf File Explorer has no name of its own for (see the setting above and FileTypes.json)."/>
                <CheckBox x:Name="TitleFromNfoBox" Content="Title from the .nfo File Overrides the Title in the Video File" Margin="0,8,0,0"
                          ToolTip="The Title column of a video shows the title written in its .nfo file, when it has one. Off, it shows the title stored inside the video file itself, which is often just the name of the release.&#10;The Year column always comes from the .nfo file.&#10;A folder is read again (open another folder and come back) to show the change."/>
                <CheckBox x:Name="SuggestMoveBox" Content="Auto-Suggest File Move When Renaming Video Files" Margin="0,8,0,0"
                          ToolTip="After a video file is renamed with Use Smart Name, offers to move it to Movies (a movie) or TV Shows\Show Name (an episode) in your Videos folder, unless it is already in the Videos folder. You can change the folder before the file is moved."/>
            </StackPanel>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Menus">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Folder Tree" Padding="8" Margin="0,8,0,0">
            <CheckBox x:Name="RightClickSelectsNodeBox" Content="Right-Clicking a Folder in the Tree Selects It"
                      ToolTip="On: a right-click on a folder in the tree selects it first, so the list shows that folder, as a right-click on a file in the list selects the file. Off: the selected folder and the list stay as they are, and the folder you right-clicked gets an outline while its menu is open, as in Windows Explorer."/>
        </GroupBox>
        <GroupBox Header="Terminal Menu (Right-Click an Item to Open It as the Administrator)" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="TerminalBox" Content="Open in Terminal"
                          ToolTip="Show Open in Terminal (Windows Terminal) in the right-click menu of a folder"/>
                <CheckBox x:Name="PowerShellBox" Content="Open in PowerShell" Margin="0,6,0,0"
                          ToolTip="Show Open in PowerShell in the right-click menu of a folder"/>
                <CheckBox x:Name="CommandPromptBox" Content="Open in Command Prompt" Margin="0,6,0,0"
                          ToolTip="Show Open in Command Prompt in the right-click menu of a folder"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Folder Tree Menu (Right-Click in the Tree)" Padding="8" Margin="0,8,0,0">
            <StackPanel x:Name="TreeMenuChoicesPanel"/>
        </GroupBox>
        <GroupBox Header="File List Menu (Right-Click in the List)" Padding="8" Margin="0,8,0,0">
            <StackPanel x:Name="ListMenuChoicesPanel"/>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Search">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Standard Folders to Exclude from Searches" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                           Text="One folder per line. In the Search window the check box Exclude Folders from the Search leaves these out of a search, which can make a search on a big drive much faster."/>
                <TextBox x:Name="SearchExcludedBox" Margin="0,8,0,0" MinHeight="150" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         ToolTip="A full path, for example C:\MyFolder (that folder and everything below it is skipped), or just a name, for example node_modules (every folder with that name, anywhere, is skipped)."/>
                <Button x:Name="SearchExcludedAddButton" Content="Add Folder..." HorizontalAlignment="Left" Padding="16,5" Margin="0,8,0,0"
                        Click="SearchExcludedAdd_Click"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Opacity="0.75"
                           Text="A line with a backslash is a full path. A line without one is a folder name, for example node_modules, __pycache__ or .git. The folder you search in is never skipped, only what lies below it."/>
            </StackPanel>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Security">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Administrator Permission" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="AskBeforeAdminBox" Content="Show a Message Box Before Windows Asks for Administrator Permission"
                          ToolTip="On: when copying, moving, deleting, renaming or creating in a protected folder (such as Program Files) needs administrator permission, a message box with a question comes first.&#10;Off: Windows' own permission prompt shows at once."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Starting Programs" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="AskBeforeProgramsBox" Content="Ask Before Starting a Program"
                          ToolTip="On: before a program is started from the file list, from a bookmark, or by dropping files on it, a question shows its name and path, and you choose Start or Cancel. In the question you can choose not to be asked again for that file, or for any file (the same as turning this off)."/>
                <CheckBox x:Name="AskInArchivesBox" Content="Ask Before Starting a Program Inside a Compressed File (Recommended)" Margin="0,6,0,0"
                          ToolTip="On: the same question for a program inside a zip, RAR or other compressed file, with a warning, and Cancel as the default button. It has its own setting because a program from a compressed file has not been checked by Windows."/>
                <Button x:Name="ForgetChoicesButton" Content="Ask Again About All Programs..." HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3"
                        ToolTip="Forgets every &quot;Don't Ask Again for This File&quot; you chose in the question, so you are asked about those programs again. It happens at once, not when you press OK."
                        Click="ForgetChoices_Click"/>
                <TextBlock Text="File Types That Count as Programs:" Margin="0,14,0,4"/>
                <UniformGrid x:Name="ProgramKindsPanel" Columns="2"/>
                <TextBlock Text="Other File Types (Separated by Semicolons):" Margin="0,8,0,4"/>
                <TextBox x:Name="ProgramExtensionsBox"
                         ToolTip="Extensions of your own, for example sh;lnk. Only the last extension of a file name counts. Right-click for Clear."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="VirusTotal" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="Your own free API key lets Send to VirusTotal show the result here and upload a file VirusTotal does not know yet. Without a key it only opens VirusTotal's page for the file."/>
                <!-- Three columns in the order of the tab key: the label, the key (a PasswordBox, or a TextBox while the eye is pressed), the eye -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="API key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="VirusTotalKeyBox" MaxLength="64"
                                     ToolTip="The 64 characters you get on VirusTotal's website. It is kept encrypted for your Windows user. Leave it empty to remove it."/>
                        <TextBox x:Name="VirusTotalKeyText" MaxLength="64" Visibility="Collapsed"
                                 ToolTip="The 64 characters you get on VirusTotal's website. It is kept encrypted for your Windows user. Leave it empty to remove it."/>
                    </Grid>
                    <ToggleButton x:Name="VirusTotalKeyEye" Grid.Column="2" Width="34" Margin="6,0,0,0" Padding="0"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Content="&#xE7B3;"
                                  ToolTip="Show the API key" Checked="VirusTotalKeyEye_Changed" Unchecked="VirusTotalKeyEye_Changed"/>
                </Grid>
                <TextBlock Margin="0,6,0,0">
                    <Hyperlink NavigateUri="https://www.virustotal.com/gui/my-apikey" RequestNavigate="VirusTotalKeyLink_Navigate">Get a Free API Key</Hyperlink>
                </TextBlock>
            </StackPanel>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <!-- Only shown when SweWolf Media Player is found (SettingsWindow.xaml.cs): without the player there is nothing to set. -->
            <TabItem x:Name="MediaPlayerTab" Header="Media Player">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Startup" Padding="8">
            <CheckBox x:Name="PreloadPlayerBox" Content="Preload SweWolf Media Player in the Background at Startup"
                      ToolTip="The first start of the player can take a long time while the antivirus program scans its files. On: when this program starts, the player is loaded once in the background, with no window, so it opens fast later."/>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Scrapers">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="The Movie Database (TMDB)" Padding="8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Text="Your own free TMDB API key lets &quot;Download NFO File...&quot; (right-click in the plot area under the list) look up a movie or TV show and save its details as an .nfo file next to your video."/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="API key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="TmdbKeyBox"
                                     ToolTip="Either the 32-character API Key or the long API Read Access Token from your TMDB account. It is kept encrypted for your Windows user. Leave it empty to remove it."/>
                        <TextBox x:Name="TmdbKeyText" Visibility="Collapsed"
                                 ToolTip="Either the 32-character API Key or the long API Read Access Token from your TMDB account. It is kept encrypted for your Windows user. Leave it empty to remove it."/>
                    </Grid>
                    <ToggleButton x:Name="TmdbKeyEye" Grid.Column="2" Width="34" Margin="6,0,0,0" Padding="0"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Content="&#xE7B3;"
                                  ToolTip="Show the API key" Checked="TmdbKeyEye_Changed" Unchecked="TmdbKeyEye_Changed"/>
                </Grid>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api" RequestNavigate="TmdbKeyLink_Navigate">Get a Free API Key</Hyperlink>
                    <Run Text=" (free TMDB account needed; choose Developer when asked what the key is for)"/>
                </TextBlock>
            </StackPanel>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Troubleshooting">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel Margin="8">
        <GroupBox Header="Logging" Padding="8">
            <StackPanel>
                <CheckBox x:Name="LogInternetBox" Content="Log All Internet Calls"
                          ToolTip="Write every call the program makes to a web service (what was asked, the answer and the time) to internet.log, which you find with Help > Open Log Folder. Passwords and API keys are never written to it."/>
                <CheckBox x:Name="LogWarningsBox" Content="Log Warnings" Margin="0,10,0,0"
                          ToolTip="Also write warnings to errors.log: things that did not work at first but were handled, for example a step that needed administrator permission. Errors are always written."/>
                <CheckBox x:Name="LogSearchesBox" Content="Log Searches" Margin="0,10,0,0"
                          ToolTip="Write what the last search did, folder by folder, with the time each folder took, to search.log (made new for every search; it can be several MB for a big drive). The 25 slowest folders are listed at the end. Find it with Help > Open Log Folder."/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Opacity="0.75"
                           Text="Off normally. Turn it on to see what the program asks the internet for, for example when a search finds something unexpected. Warnings are lines starting with &quot;Warning:&quot;. Errors are always written to errors.log, whatever this says."/>
            </StackPanel>
        </GroupBox>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="115" Margin="0,0,6,0" IsDefault="True" Click="OkButton_Click"
                    BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" BorderThickness="2"/>
            <Button Content="Cancel" Width="115" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
