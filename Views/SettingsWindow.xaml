<Window x:Class="SwewolfFileExplorer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=StyleBox}">

    <StackPanel Margin="12" MinWidth="320">

        <GroupBox Header="Appearance" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="StyleBox" Width="140"
                          ToolTip="Light, Dark, the same as Windows, or Cyber (light blue on black)">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Cyber"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
