<Window x:Class="SwewolfFileExplorer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=StyleBox}">

    <Window.Resources>
        <!-- Tabs that look like the tabs of the main window: a 3 px accent line on top, a distinct background and bold text for the selected one. -->
        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,3,0,0" CornerRadius="6,6,0,0" Padding="18,6">
                            <ContentPresenter x:Name="TabContent" TextElement.Foreground="{TemplateBinding Foreground}" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"/>
                                <Setter TargetName="TabContent" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12" MinWidth="420">

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="8">
        <GroupBox Header="Appearance" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="StyleBox" Width="140"
                          ToolTip="Light, Dark, the same as Windows, or Cyber Cyan (light blue on black)">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Cyber Cyan"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Unread Files" Padding="8" Margin="0,8,0,0"
                  ToolTip="How a file that has not been opened in this app yet looks in the file list">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="UnreadBoldBox"   Content="Bold"   Margin="0,0,16,0"/>
                <CheckBox x:Name="UnreadItalicBox" Content="Italic"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Drag and Drop" Padding="8" Margin="0,8,0,0">
            <CheckBox x:Name="DisableDragDropBox" Content="Disable Internal Drag and Drop"
                      ToolTip="On: files cannot be copied or moved by dragging them onto the list or the tree, and dragging with the right mouse button is off. Dragging a picture in from a web browser, and dragging files out of the list to a web browser or another program with the left button, always work."/>
        </GroupBox>
        <GroupBox Header="VirusTotal" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Your own free API key lets Send to VirusTotal show the result here and upload a file VirusTotal does not know yet. Without a key it only opens VirusTotal's page for the file."/>
                <DockPanel Margin="0,6,0,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="API key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="VirusTotalKeyEye" DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" Padding="0" TabIndex="1" IsTabStop="True"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Content="&#xE7B3;"
                                  ToolTip="Show the API key" Checked="VirusTotalKeyEye_Changed" Unchecked="VirusTotalKeyEye_Changed"/>
                    <Grid KeyboardNavigation.TabIndex="0">
                        <PasswordBox x:Name="VirusTotalKeyBox" MaxLength="64"
                                     ToolTip="The 64 characters you get on VirusTotal's website. It is kept encrypted for your Windows user. Leave it empty to remove it."/>
                        <TextBox x:Name="VirusTotalKeyText" MaxLength="64" Visibility="Collapsed"
                                 ToolTip="The 64 characters you get on VirusTotal's website. It is kept encrypted for your Windows user. Leave it empty to remove it."/>
                    </Grid>
                </DockPanel>
                <TextBlock Margin="0,6,0,0">
                    <Hyperlink NavigateUri="https://www.virustotal.com/gui/my-apikey" RequestNavigate="VirusTotalKeyLink_Navigate">Get a Free API Key</Hyperlink>
                </TextBlock>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="MediaPlayerGroup" Header="Media Player" Padding="8" Margin="0,8,0,0">
            <CheckBox x:Name="PreloadPlayerBox" Content="Preload SweWolf Media Player in the Background at Startup"
                      ToolTip="The first start of the player can take a long time while the antivirus program scans its files. On: when this program starts, the player is loaded once in the background, with no window, so it opens fast later."/>
        </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Files">
                <StackPanel Margin="8">
        <GroupBox Header="Hidden Files" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Hide Files with These Extensions:" Margin="0,0,0,4"/>
                <TextBox x:Name="HiddenExtensionsBox"
                         ToolTip="Separated by semicolons, for example bup;ifo;db. These files are listed as hidden items, like files with the Hidden attribute, and do not count when a folder is checked for being read."/>

                <TextBlock Text="Also Hide Files with These Extensions When Inside Compressed Files:" Margin="0,10,0,4"/>
                <TextBox x:Name="HiddenExtensionsInArchivesBox"
                         ToolTip="Separated by semicolons, for example nfo;txt;url. Only used inside zip, RAR and other compressed files (the files of the list above are hidden there too), for example the text files that come with a comic."/>

                <CheckBox x:Name="WarnHiddenNotSelectedBox" Content="Warn When All Files Are Selected but Hidden Items Are Not" Margin="0,10,0,0"
                          ToolTip="Shows a red warning next to the hidden-items link under the list when everything shown is selected (Ctrl+A) and the folder also has hidden items that are not shown. Copying or moving the selection leaves those items out."/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="File Names" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="HideShellExtensionsBox" Content="Hide Extensions for Special Shell and System File Types"
                          ToolTip="As Windows does: a shortcut is shown as Photos, not Photos.lnk. This is about .lnk, .pif, .url, .scf, .desklink, .mapimail, .mydocs, .library-ms and .searchconnector-ms. The files are still listed, and renaming one keeps its extension."/>
                <CheckBox x:Name="HideKnownExtensionsBox" Content="Hide Extensions for Known File Types" Margin="0,8,0,0"
                          ToolTip="As Windows' Folder Options: a file is shown as Report, not Report.txt, when Windows knows its type. Off to begin with. The .ext button in the toolbar does the same. Renaming a file keeps its extension."/>
                <CheckBox x:Name="RegisteredTypeNamesBox" Content="Show the Registered Name of Each File Type (JPEG Image, Not JPG File)" Margin="0,8,0,0"
                          ToolTip="The Type column says what the file type itself is called, for example JPEG Image. Off, it shows what Windows Explorer shows, which can be the plainer JPG File when the program you have chosen to open that type gives it no name of its own."/>
                <CheckBox x:Name="SuggestMoveBox" Content="Auto-Suggest File Move When Renaming Video Files" Margin="0,8,0,0"
                          ToolTip="After a video file is renamed with Use Smart Name, offers to move it to Movies (a movie) or TV Shows\Show Name (an episode) in your Videos folder, unless it is already in the Videos folder. You can change the folder before the file is moved."/>
            </StackPanel>
        </GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Menus">
                <StackPanel Margin="8">
        <GroupBox Header="Folder Tree" Padding="8" Margin="0,8,0,0">
            <CheckBox x:Name="RightClickSelectsNodeBox" Content="Right-Clicking a Folder in the Tree Selects It"
                      ToolTip="On: a right-click on a folder in the tree selects it first, so the list shows that folder, as a right-click on a file in the list selects the file. Off: the selected folder and the list stay as they are, and the folder you right-clicked gets an outline while its menu is open, as in Windows Explorer."/>
        </GroupBox>
        <GroupBox Header="Terminal Menu (Right-Click an Item to Open It as the Administrator)" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="TerminalBox" Content="Open in Terminal"
                          ToolTip="Show Open in Terminal (Windows Terminal) in the right-click menu of a folder"/>
                <CheckBox x:Name="PowerShellBox" Content="Open in PowerShell" Margin="0,6,0,0"
                          ToolTip="Show Open in PowerShell in the right-click menu of a folder"/>
                <CheckBox x:Name="CommandPromptBox" Content="Open in Command Prompt" Margin="0,6,0,0"
                          ToolTip="Show Open in Command Prompt in the right-click menu of a folder"/>
            </StackPanel>
        </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="96" Margin="0,0,6,0" IsDefault="True" Click="OkButton_Click"
                    BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" BorderThickness="2"/>
            <Button Content="Cancel" Width="96" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
